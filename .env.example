# Copy to .env and adjust. No secrets are committed (CLAUDE.md rule 14) — these are local-dev-only
# defaults matching deploy/compose/docker-compose.yml.

# --- Postgres (deploy/db/00-bootstrap.sql roles) ---
POSTGRES_SUPERUSER_PASSWORD=postgres
PDPA_MIGRATOR_PASSWORD=pdpa_migrator
PDPA_APP_PASSWORD=pdpa_app
PDPA_PLATFORM_PASSWORD=pdpa_platform
PDPA_READONLY_PASSWORD=pdpa_readonly

# --- backend/cmd/api, backend/cmd/worker ---
DATABASE_URL=postgres://pdpa_app:pdpa_app@localhost:5432/pdpa?sslmode=disable
# backend/cmd/migrate connects as pdpa_migrator instead (options=-c role=pdpa_owner is added in code)
MIGRATOR_DATABASE_URL=postgres://pdpa_migrator:pdpa_migrator@localhost:5432/pdpa?sslmode=disable
VALKEY_ADDR=localhost:6379
OPENAPI_SPEC_PATH=api/openapi/openapi.yaml
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Keycloak — realm/org/client/mapper setup is pending decisions.md Q-18's PoC (T13); until then
# AuthN in backend/cmd/api will reject every token because no such realm/issuer exists yet.
OIDC_ISSUER=http://localhost:8081/realms/pdpa
OIDC_JWKS_URL=http://localhost:8081/realms/pdpa/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

OTEL_EXPORTER_OTLP_ENDPOINT=

# --- object storage (deploy/compose minio) ---
MINIO_ROOT_USER=pdpa_minio
MINIO_ROOT_PASSWORD=pdpa_minio_secret

# --- apps/admin, apps/portal (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
AUTH_SECRET=change-me-with-openssl-rand-base64-32
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/pdpa
AUTH_KEYCLOAK_ID=pdpa-admin
AUTH_KEYCLOAK_SECRET=change-me
