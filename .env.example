# Copy to .env and adjust. No secrets are committed (CLAUDE.md rule 14) — these are local-dev-only
# defaults matching deploy/compose/docker-compose.yml, EXCEPT DATABASE_URL / MIGRATOR_DATABASE_URL
# below, which point at port 5433 — see "Local Postgres without Docker" in README.md.

# --- Postgres (deploy/db/00-bootstrap.sql roles) ---
POSTGRES_SUPERUSER_PASSWORD=postgres
PDPA_MIGRATOR_PASSWORD=pdpa_migrator
PDPA_APP_PASSWORD=pdpa_app
PDPA_PLATFORM_PASSWORD=pdpa_platform
PDPA_READONLY_PASSWORD=pdpa_readonly

# --- backend/cmd/api, backend/cmd/worker ---
# Port 5433, not the usual 5432: this machine already has an unrelated Postgres 18 on 5432, so the
# Homebrew postgresql@17 instance set up for this project (see README.md) listens on 5433 instead.
# Using deploy/compose/docker-compose.yml's Postgres instead? That one binds 5432 as usual — change
# the port back to 5432 in both URLs below if you switch to it.
DATABASE_URL=postgres://pdpa_app:pdpa_app@localhost:5433/pdpa?sslmode=disable
# backend/cmd/devseed only (creates the dev-login demo tenant, which only the provider role may write)
PLATFORM_DATABASE_URL=postgres://pdpa_platform:pdpa_platform@localhost:5433/pdpa?sslmode=disable
# backend/cmd/migrate connects as pdpa_migrator instead (options=-c role=pdpa_owner is added in code)
MIGRATOR_DATABASE_URL=postgres://pdpa_migrator:pdpa_migrator@localhost:5433/pdpa?sslmode=disable
VALKEY_ADDR=localhost:6379
OPENAPI_SPEC_PATH=api/openapi/openapi.yaml
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Load balancers / reverse proxies in front of the API whose X-Forwarded-For is trusted (IPs or CIDRs,
# comma separated; decisions.md D-23). Empty: the TCP peer is the client. Set it in every deployment
# behind a proxy, or the audit log and rate limiter see the proxy's address. The admin BFF and the portal
# forward the browser's X-Forwarded-For, so include their addresses too (e.g. 127.0.0.1 when run locally).
TRUSTED_PROXIES=
# backend/cmd/worker: months platform.audit_log is kept (decisions.md D-22: 60; longer only)
AUDIT_RETENTION_MONTHS=60

# Who signs the access tokens the API accepts. Locally: the admin app's dev login (AUTH_DEV_LOGIN below) —
# Keycloak's realm/org/client/mapper setup is pending decisions.md Q-18's PoC (T13). With Keycloak, use
#   OIDC_ISSUER=http://localhost:8081/realms/pdpa
#   OIDC_JWKS_URL=http://localhost:8081/realms/pdpa/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:3000/dev-auth
OIDC_JWKS_URL=http://localhost:3000/api/dev-auth/jwks
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

OTEL_EXPORTER_OTLP_ENDPOINT=

# --- object storage (deploy/compose minio) ---
MINIO_ROOT_USER=pdpa_minio
MINIO_ROOT_PASSWORD=pdpa_minio_secret
# files (PLT-09): backend/cmd/api + cmd/worker. S3_SSE=true needs a KMS configured on the storage side.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=pdpa_minio
S3_SECRET_KEY=pdpa_minio_secret
S3_BUCKET=pdpa-files
S3_USE_TLS=false
S3_SSE=false
CLAMD_ADDR=localhost:3310

# --- PII encryption (PLT-13): OpenBao Transit; KEK_PROVIDER=local + LOCAL_KEK_BASE64 (openssl rand -base64 32) for dev only
KEK_PROVIDER=local
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=
LOCAL_KEK_BASE64=

# --- notifications (PLT-04): e-mail via SMTP (compose mailpit on :1025); SMS / LINE are mocks until Q-03 is decided
SMTP_ADDR=localhost:1025
SMTP_FROM=noreply@pdpa.local

# --- apps/admin, apps/portal (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
AUTH_SECRET=change-me-with-openssl-rand-base64-32
# Dev login (apps/admin/src/lib/dev-auth.ts): sign in as the demo admin created by `make dev-seed`, no Keycloak.
# Works only with `next dev` (never in a production build) and only while the API trusts OIDC_ISSUER above.
AUTH_DEV_LOGIN=true
AUTH_DEV_TENANT_ID=0199a000-0000-7000-8000-00000000d001
AUTH_DEV_USER_ID=0199a000-0000-7000-8000-00000000d002
# Keycloak instead (turn AUTH_DEV_LOGIN off and point OIDC_* at the realm):
# AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/pdpa
# AUTH_KEYCLOAK_ID=pdpa-admin
# AUTH_KEYCLOAK_SECRET=change-me
