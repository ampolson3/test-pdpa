value="บุคคล / หน่วยงานภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1472" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc03-v35" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1576" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc03-v36" value="ระบบ / บริการภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1556" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc03-v37" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;&lt;br&gt;• เส้นทึบ = actor ใช้งาน use case&lt;br&gt;• «include» = use case ต้นทางเรียกใช้ปลายทางทุกครั้ง&lt;br&gt;• «extend» = ส่วนขยายที่เกิดตามเงื่อนไข ชี้ไปยัง use case หลัก&lt;br&gt;• สีวงรี = ความสำคัญ (Must / Should / Nice)&lt;br&gt;• Pn = phase ในแผนพัฒนา (P0–P4)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1400" y="396" width="260" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc04" name="UC-04 CON"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="2462" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uc04-v3" value="ระบบบริหารจัดการความยินยอม&lt;br&gt;(Cookies and Consent Management)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#1F4E78;strokeWidth=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="138" width="500" height="2284" as="geometry"/></mxCell><mxCel