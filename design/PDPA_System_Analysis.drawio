_agreements__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd13-e15" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_agreement_signature_requests__agreement_id" target="t_agreement_agreements__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd13-e16" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_agreement_obligations__agreement_id" target="t_agreement_agreements__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd13-e17" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_agreement_return_confirmations__agreement_id" target="t_agreement_agreements__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd13-e18" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_agreement_downloads__agreement_id" target="t_agreement_agreements__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd13-v1" value="ERD-13  ER Diagram — Vendor &amp;amp; Agreement — คู่ค้า ผู้ประมวลผล และข้อตกลง DPA/DSA" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1760" height="34" as="geometry"/></mxCell><mxCell id="erd13-v2" value="PK = primary key · FK = foreign key (มี constraint) · LFK = logical FK ไปตาราง partition (ตรวจใน service) · UQ = unique ต่อ tenant · ชื่อคอลัมน์ตัวหนา = NOT NULL · {a|b} = ค่าที่อนุญาต (CHECK) · → ตาราง = ตารางปลายทาง (ข้าม schema แสดงชื่อ schema) · ⟨P⟩ = partition รายเดือน · ⟨G⟩ = มีข้อมูลกลางของแพลตฟอร์ม&lt;br&gt;ทุกตารางมี tenant_id + RLS และคอลัมน์ created_at, created_by, updated_at, updated_by, row_version (ไม่แสดงเพื่อลดความรก) — รายละเอียดครบอยู่ในไฟล์ pdpa_schema.sql" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1760" height="76" as="geometry"/></mxCell><mxCell id="t_vendor_vendors" value="vendor.&lt;b&gt;vendors&lt;/b&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fontSize=11;rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="310" height="302" as="geometry"/></mxCell><mxCell id="t_vendor_vendors__desc" value="&lt;i&gt;คู่ค้า / ผู้ประมวลผล (ต่อยอดจาก org.external_parties)&lt;/i&gt;" style="text;strokeColor=#E0E0E0;fillColor=#FAFAFA;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=10;fontColor=#595959;points=[];" vertex="1" parent="t_vendor_vendors"><mxGeometry x="0" y="26" width="310" height="20" as="geometry"/></mxCell><mxCell id="t_vendor_vendors__id" value='&lt;b&gt;PK&lt;/b&gt;&amp;nbsp; &lt;b&gt;id&lt;/b&gt; &lt;font color="#7F7F7F"&gt;uuid&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=10;fillColor=#F5F9FF;" vertex="1" parent="t_vendor_vendors"><mxGeometry x="0" y="46" width="310" height="20" as="geometry"/></mxCell><mxCell id="t_vendor_vendors__party_id" value='&lt;b&gt;&lt;font color="#1F4E78"&gt;FK&lt;/font&gt;&lt;/b&gt; &lt;b&gt;