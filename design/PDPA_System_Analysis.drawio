arent="1" source="uc08_DFG-01" target="uc08_DFG-03"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="411.0"/><mxPoint x="862" y="595.0"/></Array></mxGeometry></mxCell><mxCell id="uc08-e20" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc08_DFG-01" target="uc08_DFG-04"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="892" y="411.0"/><mxPoint x="892" y="687.0"/></Array></mxGeometry></mxCell><mxCell id="uc08-e21" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc08_DFG-02" target="uc08_DFG-01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc08-e22" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc08_DFG-09" target="uc08_DFG-01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc08-v1" value="UC-08  Use Case — DFG: ระบบจัดการแผนผังการไหลของการประมวลผลข้อมูลส่วนบุคคลแบบอัตโนมัติ (Data Flow Generator)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="uc08-v2" value="ขอบเขต: แผนผังการไหลของข้อมูลที่สร้างจาก RoPA และการค้นหาข้อมูลอัตโนมัติ&lt;br&gt;11 use cases · Must 5 · Should 4 · Nice 2 · รหัส use case = Function ID ใน Development Plan (ดู acceptance criteria และ task ได้จากรหัสเดียวกัน) · Pn = phase ที่พัฒนา" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="58" as="geometry"/></mxCell><mxCell id="uc08_DFG-10" value='&lt;b&gt;DFG-10&lt;/b&gt; แผนผังระดับระบบ (Data lineage)&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;System-level lineage · P4&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-09" value='&lt;b&gt;DFG-09&lt;/b&gt; ค้นหาข้อมูลส่วนบุคคลอัตโนมัติ (Data Discovery)&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Data discovery · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="286" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-01" value='&lt;b&gt;DFG-01&lt;/b&gt; สร้างแผนผังอัตโนมัติจาก RoPA&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Auto data flow diagram · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-02" value='&lt;b&gt;DFG-02&lt;/b&gt; อัปเดตแผนผังเมื่อข้อมูลเปลี่ยน&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Auto refresh · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-03" value='&lt;b&gt;DFG-03&lt;/b&gt; แสดงการโอนไปต่างประเทศ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Cross-border mapping · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="562" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-04" value='&lt;b&gt;DFG-04&lt;/b&gt; แสดงผู้ประมวลผลและผู้รับข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Processor &amp;amp; recipient mapping · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="654" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-06" value='&lt;b&gt;DFG-06&lt;/b&gt; มุมมองหลายระดับ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Multi-view · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="746" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-05" value='&lt;b&gt;DFG-05&lt;/b&gt; แก้ไขแผนผังแบบลากวาง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Drag &amp;amp; drop editor · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="838" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-07" value='&lt;b&gt;DFG-07&lt;/b&gt; เผยแพร่และประวัติเวอร์ชันแผนผัง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Publish &amp;amp; history · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-11" value='&lt;b&gt;DFG-11&lt;/b&gt; แผนที่โลกของการโอนข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Transfer world map · P4&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="1022" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_DFG-08" value='&lt;b&gt;DFG-08&lt;/b&gt; ส่งออกภาพและรายงาน&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Export image &amp;amp; report · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1114" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc08_a_OWNER" value="เจ้าของกระบวนการ / ผู้ประสานงานแผนก&lt;br&gt;&lt;i&gt;(Process Owner / Champion)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="563.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc08_a_IT" value="เจ้าของระบบ / IT&lt;br&gt;&lt;i&gt;(System Owner / IT)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="241.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc08_a_DATASRC" value="แหล่งข้อมูล (DB / File / Cloud)&lt;br&gt;&lt;i&gt;(Data Sources)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="220" y="369.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc08_a_DPO" value="DPO / Privacy Team&lt;br&gt;&lt;i&gt;(DPO / Privacy Team)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1170" y="781.5" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc08_a_AUDIT" value="ผู้ตรวจสอบ&lt;br&gt;&lt;i&gt;(Auditor)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1170" y="1115.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc08_a_SCHED" value="ระบบ: Scheduler / Event&lt;br&gt;&lt;i&gt;(System Timer &amp;amp; Events)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1170" y="471.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc08-v23" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1430" y="138" width="260" height="22" as="geometry"/></mxCell><mxCell id="uc08-v24" value="Must — กฎหมายกำหนด / จำเป็น" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="166" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc08-v25" value="Should — มาตรฐานตลาด" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="212" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc08-v26" value="Nice-to-have — จุดขายเพิ่ม" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="258" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc08-v27" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1438" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc08-v28" value="ผู้ใช้ภายในองค์กร" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1418" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc08-v29" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1522" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc08-v30" value="บุคคล / หน่วยงานภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1502" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc08-v31" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1606" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc08-v32" value="ระบบ / บริการภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1586" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc08-v33" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;&lt;br&gt;• เส้นทึบ = actor ใช้งาน use case&lt;br&gt;• «include» = use case ต้นทางเรียกใช้ปลายทางทุกครั้ง&lt;br&gt;• «extend» = ส่วนขยายที่เกิดตามเงื่อนไข ชี้ไปยัง use case หลัก&lt;br&gt;• สีวงรี = ความสำคัญ (Must / Should / Nice)&lt;br&gt;• Pn = phase ในแผนพัฒนา (P0–P4)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="396" width="260" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc09" name="UC-09 DSAR"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="2186" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uc09-v3" value="ระบบจัดการคำขอใช้สิทธิของเจ้าของข้อมูลส่วนบุคคล&lt;br&gt;(Data Subject Access Request (DSAR))" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#1F4E78;strokeWidth=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="138" width="470" height="2008" as="geometry"/></mxCell><mxCell id="uc09-e4" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_GUARD" target="uc09_DSAR-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e5" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_DS" target="uc09_DSAR-01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e6" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_FRONT" target="uc09_DSAR-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e7" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_EXT" target="uc09_DSAR-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e8" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_DS" target="uc09_DSAR-06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e9" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_DPO" target="uc09_DSAR-06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e10" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc09_a_DS" target="uc09_DSAR-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e11" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1