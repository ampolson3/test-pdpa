"uc14_a_PROC" value="จัดซื้อ / ผู้ดูแลคู่ค้า&lt;br&gt;&lt;i&gt;(Procurement / Vendor Manager)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="397.4" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_OWNER" value="เจ้าของกระบวนการ / ผู้ประสานงานแผนก&lt;br&gt;&lt;i&gt;(Process Owner / Champion)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="195.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_VENDOR" value="คู่ค้า / ผู้ประมวลผล (guest)&lt;br&gt;&lt;i&gt;(Vendor / Processor)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="220" y="885.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_DPO" value="DPO / Privacy Team&lt;br&gt;&lt;i&gt;(DPO / Privacy Team)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="783.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_SEC" value="ทีม Security / Incident&lt;br&gt;&lt;i&gt;(Security / Incident Response)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="1151.8" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_EXEC" value="ผู้บริหาร / ผู้มีอำนาจอนุมัติ&lt;br&gt;&lt;i&gt;(Executive / Approver)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="655.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_SCHED" value="ระบบ: Scheduler / Event&lt;br&gt;&lt;i&gt;(System Timer &amp;amp; Events)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1110" y="1484.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14_a_LLM" value="บริการ AI (LLM)&lt;br&gt;&lt;i&gt;(AI Service)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1110" y="1356.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc14-v36" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1370" y="138" width="260" height="22" as="geometry"/></mxCell><mxCell id="uc14-v37" value="Must — กฎหมายกำหนด / จำเป็น" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="166" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc14-v38" value="Should — มาตรฐานตลาด" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="212" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc14-v39" value="Nice-to-have — จุดขายเพิ่ม" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="258" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc14-v40" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1378" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc14-v41" value="ผู้ใช้ภายในองค์กร" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1358" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc14-v42" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1462" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc14-v43" value="บุคคล / หน่วยงานภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1442" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc14-v44" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1546" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc14-v45" value="ระบบ / บริการภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1526" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc14-v46" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;&lt;br&gt;• เส้นทึบ = actor ใช้งาน use case&lt;br&gt;• «include» = use case ต้นทางเรียกใช้ปลายทางทุกครั้ง&lt;br&gt;• «extend» = ส่วนขยายที่เกิดตามเงื่อนไข ชี้ไปยัง use case หลัก&lt;br&gt;• สีวงรี = ความสำคัญ (Must / Should / Nice)&lt;br&gt;• Pn = phase ในแผนพัฒนา (P0–P4)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="396" width="260" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc15" name="UC-15 DPA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1542" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uc15-v3" value="ระบบจัดการเอกสารข้อตกลงการประมวลผลข้อมูลส่วนบุคคล&lt;br&gt;(Data Processing Agreement)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#1F4E78;strokeWidth=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="138" width="500" height="1364" as="geometry"/></mxCell><mxCell id="uc15-e4" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc15_a_LEGAL" target="uc15_DPA-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc15-e5" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc15_a_PROC" target="uc15_DPA-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc15-e6" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc15_a_LEGAL" target="uc15_DPA-01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc15-e7" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc15_a_LEGAL" target="uc15_DPA-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc15-e8" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc15_a_LEGAL" target="uc15_DPA-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc15-e9" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc15_a_LEGAL" target="uc15_DPA-05"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mx