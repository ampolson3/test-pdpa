cingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="665.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp08_t3" value="บันทึกเหตุผลที่ไม่ต้องทำ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="382.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_e1" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="837.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp08_t4" value='สร้าง assessment จาก template + prefill RoPA&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;assessments · sections&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_t5" value='อธิบายการประมวลผล ความจำเป็น ได้สัดส่วน และความเสี่ยง&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;answers&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_t6" value="ระบุมาตรการควบคุม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_t7" value='คำนวณ inherent / residual risk&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;risk.risks · risk_controls&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_t8" value='ให้ความเห็น DPO&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;dpo_opinions&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_g2" value="residual risk ยอมรับได้?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1673.0" y="662.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp08_t10" value="อนุมัติผล DPIA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="784.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_t9" value='ตัดสินใจ: เพิ่มมาตรการ / ยอมรับความเสี่ยง / ยกเลิก&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;risk.acceptances&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="902.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_t11" value="ปิด + ตั้งรอบทบทวน + เชื่อม RoPA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1957.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp08_e" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2181.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp08-v25" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• ทำ DPIA เมื่อการประมวลผลมีแนวโน้มความเสี่ยงสูง: ข้อมูลอ่อนไหว (ม.26), การติดตามพฤติกรรมอย่างเป็นระบบ, ปริมาณมาก, เทคโนโลยีใหม่ / AI, กลุ่มเปราะบาง (เกณฑ์ตาม TDPG)&lt;br&gt;• ผลคัดกรองว่าไม่ต้องทำต้องบันทึกเหตุผล (หลักฐานการตัดสินใจ)&lt;br&gt;• ความเห็น DPO ต้องบันทึกไว้แม้ผู้บริหารตัดสินใจต่างออกไป (ความเป็นอิสระของ DPO ม.42)&lt;br&gt;• การยอมรับความเสี่ยงต้องมีผู้มีอำนาจตามเกณฑ์ risk matrix และวันหมดอายุการยอมรับ&lt;br&gt;• มาตรการต้องเหมาะสมตาม ม.37(1) และประกาศมาตรการความปลอดภัย พ.ศ. 2565; ทบทวน DPIA เมื่อกิจกรรมเปลี่ยน หรือทุก 12 เดือน" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1028" width="1039" height="105" as="geometry"/></mxCell><mxCell id="bp08-v26" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• assess.templates · screening_rules · assessments&lt;br&gt;• assess.sections · answers · assessment_risks · dpo_opinions&lt;br&gt;• risk.risks · risk_controls · controls · acceptances&lt;br&gt;• ropa.processing_activities (source)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1099" y="1028" width="610" height="92" as="geometry"/></mxCell><mxCell id="bp08-v27" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /admin/v1/assessments (type = DPIA)&lt;br&gt;• POST /admin/v1/assessments/{id}/submit · /opinion · /decision&lt;br&gt;• event: risk.dpia_required · dpia.submitted · dpia.approved · risk.accepted" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1729" y="1028" width="571" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp09" name="BP-09 รับคู่ค้าใหม่และติดตามความเสี่ยงคู่ค้า"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2172" pageHeight="937" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp09-v3" value="จัดซื้อ / เจ้าของงาน" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2092" height="134" as="geometry"/></mxCell><mxCell id="bp09-v4" value="PDPA Platform · Vendor" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="2092" height="134" as="geometry"/></mxCell><mxCell id="bp09-v5" value="คู่ค้า (guest link)" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="2092" height="134" as="geometry"/></mxCell><mxCell id="bp09-v6" value="DPO / Security" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="2092" height="134" as="geometry"/></mxCell><mxCell id="bp09-v7" value="ฝ่ายกฎหมาย" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="2092" height="134" as="geometry"/></mxCell><mxCell id="bp09-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1