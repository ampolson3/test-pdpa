w=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp10_g3" target="bp10_x1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp10-e23" value="ยุติ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp10_g3" target="bp10_t9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2032.0" y="567.0"/></Array></mxGeometry></mxCell><mxCell id="bp10-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp10_t9" target="bp10_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp10-v1" value="BP-10  Business Process — จัดทำและบริหารข้อตกลง DPA / DSA (Agreement lifecycle)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp10-v2" value="Trigger: ใช้ผู้ประมวลผล / แบ่งปันข้อมูลกับผู้ควบคุมรายอื่น / ต่ออายุ · ผลลัพธ์: ข้อตกลงลงนาม มีภาระหน้าที่ที่ติดตามได้ และปิดสัญญาอย่างถูกต้อง · UC: DPA-01 ถึง DPA-14, DSA-01 ถึง DSA-14" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp10_s" value="ต้องทำ DPA / DSA" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp10_t1" value="สร้างจาก template + เลือกกิจกรรม RoPA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_t2" value='ประกอบเอกสาร: clause + merge field + ภาคผนวก&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;agreements · clauses · annexes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_t3" value='ตรวจ mandatory clauses&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;mandatory_rules&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_g1" value="ครบ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="833.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp10_t4" value="แก้ไข clause" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_t5" value="ทบทวน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="398.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_t6" value="ตรวจร่าง / เสนอแก้ไข" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="532.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_g2" value="ตกลงได้?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1337.0" y="142.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp10_t7" value='ลงนามอิเล็กทรอนิกส์&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;signature_requests&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="666.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_t8" value='เก็บฉบับลงนาม (hash) + สร้าง obligations&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;document_versions · obligations&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_m1" value="เตือนก่อนหมดอายุ 60 / 30 วัน" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1845.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp10_g3" value="ต่ออายุ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="2009.0" y="142.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp10_x1" value="ต่ออายุ: ทำ amendment (เริ่มที่ขั้นแรก)" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="2181.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp10_t9" value='คืน / ทำลายข้อมูล + ยืนยัน&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;return_confirmations&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2125.0" y="532.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp10_e" value="ปิดข้อตกลง" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2349.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp10-v25" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• DPA ต้องกำหนดให้ผู้ประมวลผลทำตามคำสั่งของผู้ควบคุม มีมาตรการความปลอดภัย แจ้งเหตุละเมิด และจัดทำบันทึกรายการ (ม.40)&lt;br&gt;• DSA / การเปิดเผยแก่ผู้ควบคุมรายอื่น: ระบุวัตถุประสงค์ ฐานกฎหมาย ข้อจำกัดการใช้ และบันทึกการเปิดเผย (ม.27, ม.39)&lt;br&gt;• การโอนข้ามประเทศต้องมีฐานตาม ม.28 หรือมาตรการคุ้มครองที่เหมาะสมตาม ม.29 (BCR / ข้อสัญญามาตรฐาน)&lt;br&gt;• ฉบับลงนามแก้ไขไม่ได้; การเปลี่ยนแปลงทำเป็น amendment (เวอร์ชันใหม่ อ้างอิงฉบับเดิม)&lt;br&gt;• obligations มีผู้รับผิดชอบและวันครบกำหนด แจ้งเตือนผ่าน workflow" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1116" height="105" as="geometry"/></mxCell><mxCell id="bp10-v26" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• agreement.agreements · parties · agreement_activities&lt;br&gt;• agreement.clauses · mandatory_rules · annexes&lt;br&gt;• agreement.signature_requests · obligations · return_confirmations · downloads&lt;br&gt;• platform.templates · clause_library · documents · document_versions" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1176" y="792" width="655" height="92" as="geometry"/></mxCell><mxCell id="bp10-v27" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /admin/v1/agreements · POST …/{id}/render (Gotenberg)&lt;br&gt;• POST …/{id}/signature-requests → callback /webhooks/esign&lt;br&gt;• event: agreement.signed · agreement.expiring · agreement.terminated" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1851" y="792" width="617" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp11" name="BP-11 ระยะเวลาเก็บรักษาและการทำลายข้อมูล"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1836" pageHeight="908" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp11-v3" value="PDPA Platform · Scheduler" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1756" height="252" as="geometry"/></mxCell><mxCell id="bp11-v4" value="เจ้าของข้อมูลในองค์กร (Data owner)" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1756" height="134" as="geometry"/></mxCell><mxCell id="bp11-v5" value="DPO" style="s