ogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t6" target="bp01_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e16" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_g2" target="bp01_t8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e17" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_g2" target="bp01_t7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t7" target="bp01_t8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t8" target="bp01_t9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e20" value="อีเมล / หน้าจอ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t8" target="bp01_t10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t10" target="bp01_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t9" target="bp01_t11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-e23" value="ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp01_t11" target="bp01_e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp01-v1" value="BP-01  Business Process — เก็บความยินยอมทุกช่องทาง (Consent capture)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp01-v2" value="Trigger: เจ้าของข้อมูลสมัคร/ใช้บริการผ่านเว็บ แอป หน้าร้าน หรือระบบของพันธมิตร · ผลลัพธ์: Consent Transaction รายวัตถุประสงค์ + หลักฐาน + แจ้งระบบปลายทาง · UC: CON-09, CON-10, CON-11, CON-14, CON-15, CON-16, CON-23" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="40" as="geometry"/></mxCell><mxCell id="bp01_s" value="เริ่มสมัคร / ใช้บริการ" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="164.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp01_t1" value='เปิดฟอร์ม โหลด collection point&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;GET /public/v1/collection-points/{key}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="277.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp01_t2" value='คืน purpose เวอร์ชันล่าสุด + ลิงก์ประกาศ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;purposes · purpose_versions&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="416.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_t3" value="อ่านประกาศ เลือกยินยอมรายวัตถุประสงค์ (ไม่ติ๊กไว้ก่อน)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="148.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_g1" value="ผู้เยาว์ / ไร้ความสามารถ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="833.0" y="294.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp01_t4" value='ขอความยินยอมผู้ใช้อำนาจปกครอง (ส่งลิงก์ยืนยัน)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;guardian_approvals&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="416.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_t5" value='ส่ง consent พร้อม Idempotency-Key&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST /public/v1/consents&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="282.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_t6" value="ตรวจ key / schema / purpose version / คำขอซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="416.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_g2" value="ต้อง Double Opt-In?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1337.0" y="428.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp01_t7" value="กดยืนยันจากอีเมล / SMS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="148.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_t8" value='บันทึก transaction + receipt (hash chain) + อัปเดตสถานะ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;consent_transactions · consent_status&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="411.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp01_t9" value='Outbox → webhook consent.* (retry ≤ 24 ชม. แล้วเข้า reconcile)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;outbox_events · downstream_syncs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="411.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp01_t10" value="ได้รับ Consent Receipt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="148.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_t11" value='อัปเดต preference / audience แล้วตอบ ACK&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST {callback} → 2xx&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="550.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp01_e1" value="ข้อมูลตรงกันทุกระบบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2013.0" y="566.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp01_e2" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1845.0" y="164.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp01-v24" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• ความยินยอมต้องขอโดยชัดแจ้ง แยกจากข้อความอื่น เข้าใจง่าย และไม่ผูกเป็นเงื่อนไขของสัญญาเกินจำเป็น (ม.19)&lt;br&gt;• ข้อมูลอ่อนไหวต้องได้ความยินยอมโดยชัดแจ้ง (ม.26) → purposes.requires_explicit = true&lt;br&gt;• ผู้เยาว์ คนไร้ความสามารถ คนเสมือนไร้ความสามารถ ต้องได้ความยินยอมจากผู้ใช้อำนาจปกครอง / ผู้อนุบาล / ผู้พิทักษ์ (ม.20)&lt;br&gt;• บันทึกเวอร์ชัน purpose และเวอร์ชันประกาศที่แสดง ณ เวลาที่ให้ความยินยอม เพื่อพิสูจน์ย้อนหลังได้&lt;br&gt;• consent_transactions เป็น append-only ห้าม UPDATE/DELETE; receipt ใช้ hash chain (prev_hash) ตรวจการแก้ไข&lt;br&gt;• Idempotency-Key ซ้ำภายใน 24 ชม. ต้องคืนผลเดิม ไม่สร้างรายการใหม่&lt;br&gt;• ระบบปลายทางไม่ตอบ ACK: retry แบบ exponential backoff ไม่เกิน 24 ชม. แล้วเข้าคิว reconcile (BP-02)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="962" height="131" as="geometry"/></mxCell><mxCell id="bp01-v25" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• consent.collection_points · collection_point_purposes&lt;br&gt;• consent.purposes · purpose_versions&lt;br&gt;• consent.data_subjects · subject_identifiers&lt;br&gt;• consent.consent_receipts · consent_transactions ⟨P⟩&lt;br&gt;• consent.consent_status · guardian_approvals · double_optin_requests&lt;br&gt;• consent.downstream_syncs · platform.outbox_events" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1022" y="676" width="564" height="118" as="geometry"/></mxCell><mxCell id="bp01-v26" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• GET /public/v1/collection-points/{key}&lt;br&gt;• POST /public/v1/consents · POST /api/v1/consents&lt;br&gt;• POST /public/v1/consents/confirm (double opt-in)&lt;br&gt;• event: consent.granted · consent.denied (ตาม transaction_type)&lt;br&gt;• webhook: HMAC-SHA256 header X-Signature, retry 1 นาที → 24 ชม." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1606" y="676" width="526" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp02" name="BP-02 ถอนความยินยอม หมดอายุ และกระทบยอด"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="921" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp02-v3" value="เจ้าของข้อมูล" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2260" height="134" as="geometry"/></mxCell><mxCell id="bp02-v4" value="PDPA Platform · Consent" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="2260" height="252" as="geometry"/></mxCell><mxCell id="bp02-v5" value="ระบบปลายทาง CRM / CDP" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="2260" height="134" as="geometry"/></mxCell><mxCell id="bp02-v6" value="DPO / การตลาด" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="2260" height="134" as="geometry"/></mxCell><mxCell id="bp02-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_s1" target="bp02_t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_t1" target="bp02_t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_t2" target="bp02_t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_t3" target="bp02_t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e11"