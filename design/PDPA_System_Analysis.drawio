;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e16" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e17" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-09"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e18" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e19" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e20" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_COUNTER" target="uc16_DSA-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e21" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_DPO" target="uc16_DSA-08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e22" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e23" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_LEGAL" target="uc16_DSA-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e24" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_COUNTER" target="uc16_DSA-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e25" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_ESIGN" target="uc16_DSA-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e26" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc16_a_DPO" target="uc16_DSA-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-e27" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc16_DSA-04" target="uc16_DSA-03"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="227.0"/><mxPoint x="862" y="1055.0"/></Array></mxGeometry></mxCell><mxCell id="uc16-e28" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc16_DSA-04" target="uc16_DSA-05"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="892" y="227.0"/><mxPoint x="892" y="595.0"/></Array></mxGeometry></mxCell><mxCell id="uc16-e29" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc16_DSA-07" target="uc16_DSA-04"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="411.0"/><mxPoint x="922" y="227.0"/></Array></mxGeometry></mxCell><mxCell id="uc16-e30" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc16_DSA-14" target="uc16_DSA-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc16-v1" value="UC-16  Use Case — DSA: ระบบจัดการเอกสารข้อตกลงการแบ่งปันข้อมูลส่วนบุคคล (Data Sharing Agreement Generator (DSA))" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="uc16-v2" value="ขอบเขต: ข้อตกลงการแบ่งปันข้อมูลระหว่างผู้ควบคุมข้อมูล (ไม่ใช่ผู้ประมวลผล)&lt;br&gt;14 use cases · Must 6 · Should 6 · Nice 2 · รหัส use case = Function ID ใน Development Plan (ดู acceptance criteria และ task ได้จากรหัสเดียวกัน) · Pn = phase ที่พัฒนา" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="58" as="geometry"/></mxCell><mxCell id="uc16_DSA-04" value='&lt;b&gt;DSA-04&lt;/b&gt; สร้างเอกสารอัตโนมัติจาก RoPA&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Auto-generate from RoPA · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-13" value='&lt;b&gt;DSA-13&lt;/b&gt; ติดตามภาระผูกพันตามข้อตกลง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Obligation tracking · P4&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="286" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-07" value='&lt;b&gt;DSA-07&lt;/b&gt; ภาคผนวกประกอบข้อตกลง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Annexes · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-01" value='&lt;b&gt;DSA-01&lt;/b&gt; ตรวจว่าต้องใช้ DSA หรือ DPA&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Agreement type check · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-05" value='&lt;b&gt;DSA-05&lt;/b&gt; ข้อกำหนดที่ต้องมี&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Mandatory clauses · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="562" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-11" value='&lt;b&gt;DSA-11&lt;/b&gt; ทะเบียนข้อตกลงและแจ้งเตือนหมดอายุ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Agreement register &amp;amp; expiry alerts · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="654" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-02" value='&lt;b&gt;DSA-02&lt;/b&gt; ข้อมูลคู่สัญญาและบทบาท&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Parties &amp;amp; roles · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="746" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-06" value='&lt;b&gt;DSA-06&lt;/b&gt; คลังข้อความสัญญา&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Clause library · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="838" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-09" value='&lt;b&gt;DSA-09&lt;/b&gt; เวอร์ชันและประวัติ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Versions &amp;amp; history · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-03" value='&lt;b&gt;DSA-03&lt;/b&gt; Template DSA มาตรฐาน&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;DSA templates · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1022" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-14" value='&lt;b&gt;DSA-14&lt;/b&gt; รองรับการแบ่งปันข้อมูลระหว่างหน่วยงานรัฐ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Inter-agency data sharing · P4&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="1114" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-08" value='&lt;b&gt;DSA-08&lt;/b&gt; ตรวจทานและอนุมัติ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Review &amp;amp; approval · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1206" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc16_DSA-10" value='&lt;b&gt;DSA-10&lt;/b&gt; ส่งออกและลงนามอิเล็กทรอนิกส์&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Export &amp;amp; e-signature · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1298" width="3