h="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v331" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1816" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v332" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1856" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v333" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1896" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v334" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9DC3E6;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1936" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v335" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1976" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v336" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2016" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v337" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2056" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v338" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2096" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v339" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2136" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v340" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#BFBFBF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2176" y="578" width="40" height="24" as="geometry"/></mxCell><mxCell id="erd00-v341" value="&lt;b&gt;ข้อสังเกตสำหรับทีมพัฒนา&lt;/b&gt;&lt;br&gt;• platform / iam / org เป็น core ที่ทุก module อ้างอิง → migrate ก่อนเสมอ (ลำดับ goose: 0001 platform → 0002 iam → 0003 org → module)&lt;br&gt;• ropa เป็นศูนย์กลางของข้อมูลธุรกิจ: consent, notice, risk, assess, dsar, breach, agreement, dataflow อ้างอิง processing_activities / assets&lt;br&gt;• FK ไปตาราง partition (audit_log, security_events, consent_transactions, cookie consent_records) ใช้ LFK: ไม่มี constraint ตรวจใน service&lt;br&gt;• Module ห้าม query ตารางของ module อื่นโดยตรงนอกจากผ่าน service interface หรือ read model — FK ข้าม schema มีไว้รักษาความถูกต้องของข้อมูลเท่านั้น&lt;br&gt;• ทุก query ต้องอยู่ใน transaction ที่ SET LOCAL app.tenant_id แล้ว (RLS บังคับ แม้ลืม WHERE tenant_id)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1486" y="618" width="730" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd01" name="ERD-01 Platform"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd01-e3" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_tenant_modules__tenant_id" target="t_platform_tenants__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e4" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_public_keys__tenant_id" target="t_platform_tenants__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e5" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERzeroToOne;" edge="1" parent="1" source="t_platform_comments__parent_id" target="t_platform_comments__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e6" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_workflow_instances__definition_id" target="t_platform_workflow_definitions__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e7" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_workflow_tasks__instance_id" target="t_platform_workflow_instances__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e8" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_sla_timers__instance_id" target="t_platform_workflow_instances__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e9" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_form_versions__form_id" target="t_platform_form_definitions__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e10" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_form_submissions__form_version_id" target="t_platform_form_versions__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-e11" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERzeroToOne;" edge="1" parent="1" source="t_platform_approvals__record_version_id" target="t_platform_record_versions__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd01-v1" value="ERD-01  ER Diagram — Platform — tenant, workflow, form, เวอร์ชันและการอนุมัติ" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="erd01-v2" value="PK = primary key · FK = foreign key (มี constraint) · LFK = logical FK ไปตาราง partition (ตรวจใน service) · UQ = unique ต่อ tenant · ชื่อคอลัมน์ตัวหนา = NOT NULL · {a|b} = ค่าที่อนุญาต (CHECK) · → ตาราง = ตารางปลายทาง (ข้าม schema แสดงชื่อ schema) · ⟨P⟩ = partition รายเดือน · ⟨G⟩ = มีข้อมูลกลางของแพลตฟอร์ม&lt;br&gt;ทุกตารางมี tenant_id + RLS และคอลัมน์ created_at, created_by, updated_at, updated_by, row_version (ไม่แสดงเพื่อลดความรก) — รายละเอียดครบอยู่ในไฟล์ pdpa_schema.sql" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="76" as="geometry"/></mxCell><mxCell id="t_platform_tenants" value="platform.&lt;b&gt;tenants&lt;/b&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fontSize=11;rounded=0;fillColor=#EEEEEE;strokeColor=#666666;swimlaneFillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="310" height="266" as="geometry"/></mxCell><mxCell id="t_platform_tenants__desc" value="&lt;i&gt;Tenant (องค์กรลูกค้า) · ไม่มี tenant_id (ข้อมูลระดับแพลตฟอร์ม)&lt;/i&gt;" style="text;strokeColor=#E0E0E0;fillColor=#FAFAFA;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=10;fontColor=#595959;points=[];" vertex="1" parent="t_platform_tenants"><mxGeometry x="0" y="26" width="310" height="20" as="geometry"/></mxCell><mxCell id="t_platform_tenants__id" value='&lt;b&gt;PK&lt;/b&gt;&amp;nbsp; &lt;b&gt;id&lt;/b&gt; &lt;font color="#7F7F7F"&gt;uuid&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=10;fillColor=#F5F9FF;" vertex="1" parent="t_platform_tenants"><mxGeometry x="0" y="46" width="310" height="20" as="geometry"/></mxCell><mxCell id="t_platform_tenants__code" value='&lt;b&gt;&lt;font color="#7030A0"&gt;UQ&lt;/font&gt;&lt;/b&gt;&amp;nbsp; &lt;b&gt;code&lt;/b&gt; &lt;font color="#7F7F7F"&gt;varchar(40)&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=10;" vertex="1" parent="t_platform_tena