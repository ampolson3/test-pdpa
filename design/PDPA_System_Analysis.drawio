ml=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc09_DSAR-04" target="uc09_DSAR-01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc09-e39" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc09_DSAR-11" target="uc09_DSAR-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="1699.0"/><mxPoint x="862" y="2067.0"/></Array></mxGeometry></mxCell><mxCell id="uc09-e40" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc09_DSAR-15" target="uc09_DSAR-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="1055.0"/><mxPoint x="862" y="779.0"/></Array></mxGeometry></mxCell><mxCell id="uc09-e41" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc09_DSAR-16" target="uc09_DSAR-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="892" y="1239.0"/><mxPoint x="892" y="779.0"/></Array></mxGeometry></mxCell><mxCell id="uc09-e42" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc09_DSAR-10" target="uc09_DSAR-08"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="1331.0"/><mxPoint x="862" y="1147.0"/></Array></mxGeometry></mxCell><mxCell id="uc09-v1" value="UC-09  Use Case — DSAR: ระบบจัดการคำขอใช้สิทธิของเจ้าของข้อมูลส่วนบุคคล (Data Subject Access Request (DSAR))" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="uc09-v2" value="ขอบเขต: รับและดำเนินการคำขอใช้สิทธิทุกประเภท รวมถึงเรื่องร้องเรียน&lt;br&gt;21 use cases · Must 13 · Should 8 · Nice 0 · รหัส use case = Function ID ใน Development Plan (ดู acceptance criteria และ task ได้จากรหัสเดียวกัน) · Pn = phase ที่พัฒนา" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="58" as="geometry"/></mxCell><mxCell id="uc09_DSAR-04" value='&lt;b&gt;DSAR-04&lt;/b&gt; ยื่นคำขอแทนเจ้าของข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Authorized agent / guardian · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-01" value='&lt;b&gt;DSAR-01&lt;/b&gt; แบบฟอร์มขอใช้สิทธิออนไลน์&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;DSR web form · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="286" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-02" value='&lt;b&gt;DSAR-02&lt;/b&gt; รับคำขอหลายช่องทาง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Multi-channel intake · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-06" value='&lt;b&gt;DSAR-06&lt;/b&gt; ยืนยันตัวตนผู้ยื่นคำขอ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Identity verification · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-19" value='&lt;b&gt;DSAR-19&lt;/b&gt; พอร์ทัลติดตามสถานะสำหรับผู้ยื่น&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Requester status portal · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="562" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-09" value='&lt;b&gt;DSAR-09&lt;/b&gt; ค้นหาข้อมูลของเจ้าของข้อมูลข้ามระบบ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Cross-system data search · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="654" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-14" value='&lt;b&gt;DSAR-14&lt;/b&gt; ส่งข้อมูลให้เจ้าของข้อมูลอย่างปลอดภัย&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Secure delivery · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="746" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-03" value='&lt;b&gt;DSAR-03&lt;/b&gt; ครอบคลุมสิทธิทุกประเภท&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;All data subject rights · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="838" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-05" value='&lt;b&gt;DSAR-05&lt;/b&gt; รับเรื่องร้องเรียนและสอบถาม&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Complaints &amp;amp; inquiries · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-15" value='&lt;b&gt;DSAR-15&lt;/b&gt; ส่งออกข้อมูลแบบอ่านได้ด้วยเครื่อง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Portability export · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1022" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-08" value='&lt;b&gt;DSAR-08&lt;/b&gt; Workflow และงานย่อย&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Workflow &amp;amp; subtasks · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1114" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-16" value='&lt;b&gt;DSAR-16&lt;/b&gt; ปกปิดข้อมูลของบุคคลอื่น&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Redaction · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1206" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-10" value='&lt;b&gt;DSAR-10&lt;/b&gt; ตรวจข้อยกเว้นก่อนลบข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Exemption &amp;amp; legal hold check · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1298" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-17" value='&lt;b&gt;DSAR-17&lt;/b&gt; ประวัติและสืบค้นคำขอ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Request history &amp;amp; search · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1390" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-20" value='&lt;b&gt;DSAR-20&lt;/b&gt; ตั้งค่า workflow แยกตามประเภทสิทธิ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Configurable workflow per right · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1482" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-12" value='&lt;b&gt;DSAR-12&lt;/b&gt; แจ้งผู้รับข้อมูลให้ดำเนินการตาม&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Notify downstream recipients · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1574" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-11" value='&lt;b&gt;DSAR-11&lt;/b&gt; ปฏิเสธคำขอพร้อมเหตุผล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Rejection with reason · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1666" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-07" value='&lt;b&gt;DSAR-07&lt;/b&gt; นับเวลา SLA 30 วัน&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;SLA tracking (30 days) · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1758" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc09_DSAR-21" value='&lt;b&gt;DSAR-21&lt;/b&gt; เชื่อมกับระบบ Consent&lt;br&g