" as="geometry"><mxPoint x="155.0" y="626" as="sourcePoint"/><mxPoint x="385.0" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq07-e21" value="&lt;b&gt;13.&lt;/b&gt; 302 signed URL (หมดอายุ 5 นาที)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=none;strokeColor=#7F7F7F;fontColor=#404040;align=right;spacingRight=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="664" as="sourcePoint"/><mxPoint x="155.0" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq07-v1" value="SEQ-07  Sequence — สร้างเอกสาร DPA / DSA / ประกาศ เป็น PDF (Gotenberg)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1800" height="34" as="geometry"/></mxCell><mxCell id="seq07-v2" value="ใช้ร่วมกับ agreement, notice, breach form และรายงาน · งานใหญ่ทำแบบ async ผ่าน worker" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1800" height="22" as="geometry"/></mxCell><mxCell id="seq07-v11" value="&lt;b&gt;3.&lt;/b&gt; ตรวจ mandatory clauses (agreement.mandatory_rules)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#BF9000;fontSize=10;align=left;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="391.0" y="256" width="214" height="36" as="geometry"/></mxCell><mxCell id="seq07-v14" value="&lt;b&gt;6.&lt;/b&gt; ประกอบ HTML (Go html/template + CSS ฟอนต์ไทย)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#BF9000;fontSize=10;align=left;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="851.0" y="378" width="214" height="36" as="geometry"/></mxCell><mxCell id="seq07-v22" value="&lt;b&gt;หมายเหตุสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• DOCX: merge field ลง .docx template แล้วแปลง PDF ผ่าน Gotenberg (LibreOffice route) เมื่อต้องการ&lt;br&gt;• ฉบับที่ส่งลงนาม / ลงนามแล้วแก้ไขไม่ได้ (sha256 ใน document_versions)&lt;br&gt;• Gotenberg อยู่ใน network ภายใน ไม่มี egress (กัน SSRF จาก HTML)&lt;br&gt;• ไฟล์ทุกไฟล์ผ่าน ClamAV ก่อนให้ดาวน์โหลด (platform.files.scan_status)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440.0" y="102" width="360" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="st01" name="ST-01 Consent status"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="591" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st01-e10" value="PENDING&lt;br&gt;[ต้องยืนยัน]" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st01-v4" target="st01-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st01-e11" value="CONSENTED" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st01-v4" target="st01-v6"><mxGeometry relative="1" x="0.55" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st01-e12" value="NOT_CONSENTED" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st01-v4" target="st01-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st01-e13" value="CONFIRMED" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st01-v5" target="st01-v6"