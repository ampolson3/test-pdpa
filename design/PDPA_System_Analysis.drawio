w=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0.365;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st02-v4" target="st02-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st02-e29" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st02-v11" target="st02-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st02-e30" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st02-v12" target="st02-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st02-e31" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st02-v13" target="st02-v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st02-v1" value="ST-02  State Machine — คำขอใช้สิทธิ (dsar.requests.status)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="34" as="geometry"/></mxCell><mxCell id="st02-v2" value="กรอบประ = สถานะที่ยังเปิดอยู่ (ผู้ขอยกเลิกได้ทุกสถานะในกรอบ) · SLA (platform.workflow_instances.sla_status) ทำงานคู่ขนาน: on_track → at_risk (วันที่ 20) → overdue (วันที่ 30)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="22" as="geometry"/></mxCell><mxCell id="st02-v3" value="&lt;b&gt;DSAR request&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="900" height="24" as="geometry"/></mxCell><mxCell id="st02-v5" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="330" width="24" height="24" as="geometry"/></mxCell><mxCell id="st02-v6" value='&lt;b&gt;received&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;รับคำขอ + เลขอ้างอิง&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="205.0" y="313.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v7" value='&lt;b&gt;verifying&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ยืนยันตัวตน / อำนาจ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="485.0" y="313.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v8" value='&lt;b&gt;in_review&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;คัดกรองสิทธิ / ข้อยกเว้น&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765.0" y="313.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v9" value='&lt;b&gt;in_progress&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ดำเนินการ subtask&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045.0" y="313.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v10" value='&lt;b&gt;awaiting_info&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;รอข้อมูลจากผู้ขอ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765.0" y="513.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v11" value='&lt;b&gt;completed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ส่งผลแล้ว&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1355.0" y="313.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v12" value='&lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ปฏิเสธ (มีเหตุผล)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045.0" y="713.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v13" value='&lt;b&gt;withdrawn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ผู้ขอยกเลิก&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="485.0" y="713.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st02-v14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1586" y="328" width="28" height="28" as="geometry"/></mxCell><mxCell id="st02-v15" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1296" y="728" width="28" height="28" as="geometry"/></mxCell><mxCell id="st02-v16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="386" y="728" width="28" height="28" as="geometry"/></mxCell><mxCell id="st02-v32" value="&lt;b&gt;กติกาสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• เปลี่ยนสถานะผ่าน workflow engine เท่านั้น (platform.workflow_instances) พร้อม audit&lt;br&gt;• rejected ต้องมี reject_reason และสร้างรายการปฏิเสธใน RoPA&lt;br&gt;• completed ต้องมี outcome (fulfilled / partially_fulfilled) และ package / communication ที่ส่งแล้ว&lt;br&gt;• awaiting_info หยุดนับ SLA ได้ถ้า request_type กำหนด pause_sla = true&lt;br&gt;• withdrawn: ผู้ขอยกเลิกผ่าน portal / เจ้าหน้าที่บันทึกแทน" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1640" y="102" width="380" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="st03" name="ST-03 Breach incident"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="601" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st03-e12" value="แจ้งเหตุ&lt;br&gt;/ deadline" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v4" target="st03-v5"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e13" value="รับเรื่อง / routing_rules" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v5" target="st03-v6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e14" value="ยืนยันเหตุ / containment" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v6" target="st03-v7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e15" value="risk_level = low | high" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v7" target="st03-v8"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e16" value="risk_level = none&lt;br&gt;/ no_notification" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v7" target="st03-v9"><mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint x="-13.4" y="14.9" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e17" value="พบข้อเท็จจริงใหม่" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v9" target="st03-v7"><mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint x="9.4" y="-10.4" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e18" value="ยื่นแจ้งแล้ว&lt;br&gt;[เกิน 72 ชม. → late_reason]" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v8" target="st03-v9"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e19" value="ไม่ใช่เหตุละเมิดข้อมูลส่วนบุคคล&lt;br&gt;/ บันทึกเหตุผล" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v6" target="st03-v10"><mxGeometry relative="1" as="geometry"><mxPoint x="-100" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e20" value="root cause + actions ครบ&lt;br&gt;/ lessons learned" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v9" target="st03-v10"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="st03-e21" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st03-v10" target="st03-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st03-v1" value="ST-03  State Machine — เหตุละเมิดข้อมูล (breach.incidents.status)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="34" as="geometry"/></mxCell><mxCell id="st03-v2" value="เวลาอ้างอิง: aware_at (ทราบเหตุ) → deadline_at = aware_at + 72 ชม. · decision: no_notification | notify_pdpc | notify_pdpc_and_subjects" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="22" as="geometry"/></mxCell><mxCell id="st03-v3" value="&lt;b&gt;Breach incident&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="900" height="24" as="geometry"/></mxCell><mxCell id="st03-v4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="250" width="24" height="24" as="geometry"/></mxCell><mxCell id="st03-v5" value='&lt;b&gt;reported&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;รับแจ้ง&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="205.0" y="233.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st03-v6" value='&lt;b&gt;triage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;คัดกรอง / มอบหมาย&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="485.0" y="233.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st03-v7" value='&lt;b&gt;assessing&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ประเมินความเสี่ยง&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765.0" y="233.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st03-v8" value='&lt;b&gt;notifying&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;แจ้ง สคส. / เจ้าของข้อมูล&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1065.0" y="233.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st03-v9" value='&lt;b&gt;remediating&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;แก้ไข / ฟื้นฟู&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1065.0" y="503.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st03-v10" value='&lt;b&gt;closed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ปิดเหตุ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625.0" y="503.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st03-v11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="496" y="518" width="28" height="28" as="geometry"/></mxCell><mxCell id="st03-v22" value="&lt;b&gt;กติกาสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• เข้า notifying ได้เมื่อมี assessment ที่อนุมัติแล้ว&lt;br&gt;• ออกจาก notifying ต้องมี pdpc_notifications (และ subject_notifications ถ้า decision รวมเจ้าของข้อมูล)&lt;br&gt;• ทุกการเปลี่ยนสถานะ append timeline_events&lt;br&gt;• timer ทำงานตั้งแต่ reported ถึงยื่นแจ้ง: เตือน T+24 / 48 / 66 ชม. · T+72 → overdue&lt;br&gt;• closed แก้ไขไม่ได้ (reopen = timeline event + กลับไป assessing โดย DPO)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1330" y="102" width="380" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="st04" name="ST-04 Agreement &amp; Notice"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="922" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st04-e14" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st04-v4" target="st04-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st04-e15" value="ส่งทบทวน&lt;br&gt;[mandatory clauses ครบ]" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="st04-v5" target="st04-v6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="st04-e16" value="ส่งกลับแก้ไข" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="st04-v6" target="st04-v5"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="st04-e17" value="อนุมัติ" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st04-v6" target="st04-v7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st04-e18" value="ส่งลงนาม" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st04-v7" t