" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1460" y="102" width="600" height="22" as="geometry"/></mxCell><mxCell id="arc05-v8" value='&lt;b&gt;http (handler)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;แปลง request/response ตาม OpenAPI · ไม่มี business logic&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="132" width="300" height="60" as="geometry"/></mxCell><mxCell id="arc05-v9" value='&lt;b&gt;service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;business rules · state machine · เรียก module อื่นผ่าน interface · เปิด transaction&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="222" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc05-v10" value='&lt;b&gt;store (sqlc)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;SQL ที่ type-safe · ไม่มี ORM&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="322" width="300" height="55" as="geometry"/></mxCell><mxCell id="arc05-v11" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;RLS&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1520" y="407" width="180" height="80" as="geometry"/></mxCell><mxCell id="arc05-v12" value='&lt;b&gt;events → outbox&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;INSERT ใน tx เดียวกัน&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="227" width="230" height="55" as="geometry"/></mxCell><mxCell id="arc05-v13" value='&lt;b&gt;jobs (River)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;งาน async / cron&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="322" width="230" height="55" as="geometry"/></mxCell><mxCell id="arc05-v19" value="&lt;b&gt;ลำดับ middleware ของ Go API (ทุก request)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="900" height="22" as="geometry"/></mxCell><mxCell id="arc05-v20" value='&lt;b&gt;1. RequestID&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;X-Request-Id&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v21" value='&lt;b&gt;2. OTel&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;trace · metric&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v23" value='&lt;b&gt;3. Recover&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;panic → 500&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v25" value='&lt;b&gt;4. Access log&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;JSON · no PII&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v27" value='&lt;b&gt;5. CORS / CSRF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ตาม surface&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v29" value='&lt;b&gt;6. Rate limit&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Valkey&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v31" value='&lt;b&gt;7. AuthN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;JWT · guest · OTP session&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="536" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v33" value='&lt;b&gt;8. Tenant&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;claim tid → ctx&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v35" value='&lt;b&gt;9. AuthZ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;x-permission + scope&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="636" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v37" value='&lt;b&gt;10. Idempotency&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Idempotency-Key&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="636" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v39" value='&lt;b&gt;11. Tx&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;BEGIN + SET LOCAL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="636" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v41" value='&lt;b&gt;12. Handler&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;→ service → store&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="636" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v43" value='&lt;b&gt;13. Audit&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;audit_log + outbox&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="636" width="150" height="60" as="geometry"/></mxCell><mxCell id="arc05-v45" value="&lt;b&gt;ข้อตกลงการเขียนโค้ด&lt;/b&gt;&lt;br&gt;• error: ใช้ problem+json (RFC 9457) พร้อม code คงที่ต่อกรณี (เช่น consent.purpose_inactive)&lt;br&gt;• optimistic locking ด้วย row_version (ETag / If-Match) → 412 เมื่อไม่ตรง · 428 เมื่อไม่ส่ง If-Match&lt;br&gt;• เวลาเก็บเป็น timestamptz (UTC) แสดงผลตาม Asia/Bangkok และปี พ.ศ. ตาม locale&lt;br&gt;• ห้าม log ข้อมูลส่วนบุคคล: ใช้ subject_ref / id เท่านั้น (มี linter ตรวจ key ต้องห้าม)&lt;br&gt;• ทุก endpoint ต้องมี x-permission ใน OpenAPI ไม่เช่นนั้น CI fail&lt;br&gt;• test: unit (service) + integration (testcontainers PostgreSQL) + contract test จาก OpenAPI" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="522" width="640" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arc06" name="ARC-06 CI-CD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="764" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arc06-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v3" target="arc06-v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v4" target="arc06-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v6" target="arc06-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v8" target="arc06-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v10" target="arc06-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc06-v12" target="arc06-v14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205.0" y="227"/><mxPoint x="135.0" y="227"/></Array></mxGeometry></mxCell><mxCell id="arc06-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v14" target="arc06-v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v16" target="arc06-v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v18" target="arc06-v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v20" target="arc06-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc06-v22" target="arc06-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc06-v1" value="ARC-06  CI/CD Pipeline และการจัดการ environment" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2100" height="34" as="geometry"/></mxCell><mxCell id="arc06-v2" value="GitOps: CI สร้างและเซ็น image แล้วอัปเดต tag ใน repo deploy · Argo CD sync ไปแต่ละ environment · migration เป็นแบบ expand → contract เพื่อ rollback ได้" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="2100" height="22" as="geometry"/></mxCell><mxCell id="arc06-v3" value='&lt;b&gt;1. Commit / PR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;trunk-based · PR ≥ 1 reviewer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v4" value='&lt;b&gt;2. Lint&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;golangci-lint · eslint · sqlfluff&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="112" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v6" value='&lt;b&gt;3. Codegen check&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;oapi-codegen · sqlc · openapi-typescript ต้องไม่มี diff&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="468" y="112" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v8" value='&lt;b&gt;4. Unit test&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;go test -race · vitest · coverage ≥ 70%&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="682" y="112" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v10" value='&lt;b&gt;5. Build&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Go binaries · Next.js · SDK → OCI images&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="896" y="112" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v12" value='&lt;b&gt;6. Security scan&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;govulncheck · osv-scanner · semgrep · trivy image&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="112" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v14" value='&lt;b&gt;7. Integration test&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;testcontainers PostgreSQL + Valkey&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v16" value='&lt;b&gt;8. SBOM + sign&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;syft · cosign → registry&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="262" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v18" value='&lt;b&gt;9. Deploy dev&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Argo CD auto-sync · PreSync: goose up&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="468" y="262" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v20" value='&lt;b&gt;10. E2E&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Playwright (admin + portal) · API contract&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="682" y="262" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v22" value='&lt;b&gt;11. SIT → UAT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;promote tag · manual approval&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="896" y="262" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v24" value='&lt;b&gt;12. Prod&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;change window · canary 10→50→100% · smoke test&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="262" width="190" height="80" as="geometry"/></mxCell><mxCell id="arc06-v26" value="&lt;b&gt;Environment&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="600" height="22" as="geometry"/></mxCell><mxCell id="arc06-v27" value="&lt;b&gt;env&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#1F4E78;fontSize=10;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="120" height="26" as="geometry"/></mxCell><mxCell id="arc06-v28" value="&lt;b&gt;deploy&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColo