ryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="st07-v6" target="st07-v8"><mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint x="-7.2" y="18.6" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e15" value="re-enable&lt;br&gt;[maker-checker]" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st07-v8" target="st07-v6"><mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint x="7.2" y="-18.6" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e23" value="outbox" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st07-v17" target="st07-v18"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e24" value="2xx" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st07-v18" target="st07-v19"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e25" value="non-2xx / timeout" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="st07-v18" target="st07-v20"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e26" value="retry: 1m · 5m · 30m · 2h · 6h · 24h" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st07-v20" target="st07-v18"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e27" value="ครบ 24 ชม. / แจ้งเตือน&lt;br&gt;+ reconcile" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st07-v20" target="st07-v21"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="st07-e28" value="replay (manual)" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st07-v21" target="st07-v18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="902"/><mxPoint x="280" y="902"/></Array></mxGeometry></mxCell><mxCell id="st07-e29" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st07-v19" target="st07-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st07-v1" value="ST-07  State Machine — บัญชีผู้ใช้ (iam.users.status) และการส่ง webhook (platform.webhook_deliveries.status)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="34" as="geometry"/></mxCell><mxCell id="st07-v2" value="สองสถานะที่มีผลต่อความปลอดภัยและความถูกต้องของการเชื่อมต่อ" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="22" as="geometry"/></mxCell><mxCell id="st07-v3" value="&lt;b&gt;User account&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="900" height="24" as="geometry"/></mxCell><mxCell id="st07-v4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="290" width="24" height="24" as="geometry"/></mxCell><mxCell id="st07-v5" value='&lt;b&gt;invited&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ส่งคำเชิญ / สร้างจาก SCIM&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="195.0" y="273.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v6" value='&lt;b&gt;active&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ใช้งานได้&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535.0" y="273.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v7" value='&lt;b&gt;locked&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ถูกล็อก&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="895.0" y="143.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v8" value='&lt;b&gt;disabled&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ปิดใช้งาน&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="895.0" y="413.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v16" value="&lt;b&gt;Webhook delivery&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="900" height="24" as="geometry"/></mxCell><mxCell id="st07-v17" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="700" width="24" height="24" as="geometry"/></mxCell><mxCell id="st07-v18" value='&lt;b&gt;pending&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;รอส่ง / รอ retry&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="195.0" y="683.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v19" value='&lt;b&gt;delivered&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ส่งสำเร็จ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535.0" y="583.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v20" value='&lt;b&gt;failed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ส่งไม่สำเร็จ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535.0" y="783.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v21" value='&lt;b&gt;dead&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;เลิก retry&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875.0" y="783.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st07-v22" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="786" y="598" width="28" height="28" as="geometry"/></mxCell><mxCell id="st07-v30" value="&lt;b&gt;กติกาสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• disabled / locked: ปฏิเสธทุก request ทันที (ตรวจสถานะใน middleware + ล้าง cache สิทธิ์)&lt;br&gt;• disable จาก SCIM ต้อง revoke refresh token ใน Keycloak และลบ session ใน Valkey&lt;br&gt;• webhook: next_retry_at ตาม backoff · ปิด subscription อัตโนมัติถ้า dead ต่อเนื่อง 3 วัน&lt;br&gt;• replay ต้องมีสิทธิ์ admin.apiclient.update และบันทึก audit" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="102" width="380" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>