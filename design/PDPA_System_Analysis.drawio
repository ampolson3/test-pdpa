6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1942" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc06_a_OWNER" value="เจ้าของกระบวนการ / ผู้ประสานงานแผนก&lt;br&gt;&lt;i&gt;(Process Owner / Champion)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="671.7" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc06_a_IT" value="เจ้าของระบบ / IT&lt;br&gt;&lt;i&gt;(System Owner / IT)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="1053.7" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc06_a_DPO" value="DPO / Privacy Team&lt;br&gt;&lt;i&gt;(DPO / Privacy Team)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1230" y="1207.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc06_a_AUDIT" value="ผู้ตรวจสอบ&lt;br&gt;&lt;i&gt;(Auditor)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1230" y="1764.3" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc06_a_EXEC" value="ผู้บริหาร / ผู้มีอำนาจอนุมัติ&lt;br&gt;&lt;i&gt;(Executive / Approver)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1230" y="1892.3" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc06_a_SCHED" value="ระบบ: Scheduler / Event&lt;br&gt;&lt;i&gt;(System Timer &amp;amp; Events)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1230" y="1636.3" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc06-v39" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1490" y="138" width="260" height="22" as="geometry"/></mxCell><mxCell id="uc06-v40" value="Must — กฎหมายกำหนด / จำเป็น" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1490" y="166" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc06-v41" value="Should — มาตรฐานตลาด" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1490" y="212" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc06-v42" value="Nice-to-have — จุดขายเพิ่ม" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1490" y="258" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc06-v43" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1498" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc06-v44" value="ผู้ใช้ภายในองค์กร" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1478" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc06-v45" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1582" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc06-v46" value="บุคคล / หน่วยงานภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1562" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc06-v47" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1666" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc06-v48" value="ระบบ / บริการภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1646" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc06-v49" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;&lt;br&gt;• เส้นทึบ = actor ใช้งาน use case&lt;br&gt;• «include» = use case ต้นทางเรียกใช้ปลายทางทุกครั้ง&lt;br&gt;• «extend» = ส่วนขยายที่เกิดตามเงื่อนไข ชี้ไปยัง use case หลัก&lt;br&gt;• สีวงรี = ความสำคัญ (Must / Should / Nice)&lt;br&gt;• Pn = phase ในแผนพัฒนา (P0–P4)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1490" y="396" width="260" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc07" name="UC-07 RTG"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uc07-v3" value="ระบบจัดเตรียมบันทึกรายการกิจกรรมประมวลผลข้อมูลส่วนบุคคลฉบับมาตรฐาน&lt;br&gt;(ROPA Template Generator)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeCol