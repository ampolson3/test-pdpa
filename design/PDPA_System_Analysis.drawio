ource="uc02_a_DPO" target="uc02_ORG-06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e12" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc02_a_PROC" target="uc02_ORG-06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e13" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc02_a_DPO" target="uc02_ORG-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e14" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc02_a_SUPER" target="uc02_ORG-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e15" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc02_a_DPO" target="uc02_ORG-08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e16" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc02_a_SUPER" target="uc02_ORG-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e17" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc02_ORG-08" target="uc02_ORG-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-e18" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc02_ORG-05" target="uc02_ORG-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc02-v1" value="UC-02  Use Case — ORG: ระบบบริหารจัดการข้อมูลหน่วยงาน (Organization Management)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="uc02-v2" value="ขอบเขต: นิติบุคคล โครงสร้างหน่วยงาน หน่วยงานภายนอก ข้อมูลตั้งต้น ปฏิทินวันทำการ และตั้งค่าองค์กร&lt;br&gt;10 use cases · Must 4 · Should 5 · Nice 1 · รหัส use case = Function ID ใน Development Plan (ดู acceptance criteria และ task ได้จากรหัสเดียวกัน) · Pn = phase ที่พัฒนา" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="58" as="geometry"/></mxCell><mxCell id="uc02_ORG-01" value='&lt;b&gt;ORG-01&lt;/b&gt; ข้อมูลหน่วยงาน / นิติบุคคล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Organization profile · P0&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-02" value='&lt;b&gt;ORG-02&lt;/b&gt; หลายนิติบุคคลและบริษัทในเครือ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Multi-entity / group · P0&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="286" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-03" value='&lt;b&gt;ORG-03&lt;/b&gt; ผู้แทนในประเทศไทย&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Local representative · P4&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-20" value='&lt;b&gt;ORG-20&lt;/b&gt; ตั้งค่าองค์กร&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Organization settings · P0&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-04" value='&lt;b&gt;ORG-04&lt;/b&gt; โครงสร้างหน่วยงานแบบลำดับชั้น&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Organization hierarchy · P0&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="562" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-05" value='&lt;b&gt;ORG-05&lt;/b&gt; ผู้ประสานงาน PDPA ประจำหน่วยงาน&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Privacy champions · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="654" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-06" value='&lt;b&gt;ORG-06&lt;/b&gt; ทะเบียนหน่วยงานภายนอก&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;External parties directory · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="746" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-07" value='&lt;b&gt;ORG-07&lt;/b&gt; ข้อมูลตั้งต้นกลาง (Master data)&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Master data · P0&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="838" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-08" value='&lt;b&gt;ORG-08&lt;/b&gt; นำเข้าและส่งออกข้อมูลตั้งต้น&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Master data import/export · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_ORG-21" value='&lt;b&gt;ORG-21&lt;/b&gt; เลือกที่เก็บข้อมูลและรูปแบบติดตั้ง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Data residency &amp;amp; deployment · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1022" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc02_a_ORGADMIN" value="ผู้ดูแลระบบขององค์กร&lt;br&gt;&lt;i&gt;(Organization Admin)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="425.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc02_a_PROC" value="จัดซื้อ / ผู้ดูแลคู่ค้า&lt;br&gt;&lt;i&gt;(Procurement / Vendor Manager)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="747.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc02_a_DPO" value="DPO / Privacy Team&lt;br&gt;&lt;i&gt;(DPO / Privacy Team)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="793.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc02_a_SUPER" value="ผู้ให้บริการแพลตฟอร์ม&lt;br&gt;&lt;i&gt;(Platform Super Admin / Content team)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="931.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc02-v19" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1370" y="138" width="260" height="22" as="geometry"/></mxCell><mxCell id="uc02-v20" value="Must — กฎหมายกำหนด / จำเป็น" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="166" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc02-v21" value="Should — มาตรฐานตลาด" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="212" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc02-v22" value="Nice-to-have — จุดขายเพิ่ม" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="258" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc02-v23" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1378" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc02-v24" value="ผู้ใช้ภายในองค์กร" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1358" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc02-v25" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1462" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc02-v26" value="บุคคล / หน่วยงานภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1442" y="354"