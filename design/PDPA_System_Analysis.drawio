ร์&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;admin API&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_2" value='&lt;b&gt;3.2&lt;/b&gt;&lt;hr size="1"&gt;แสดงฟอร์ม / แบนเนอร์ตามเวอร์ชันล่าสุด&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;public API + CDN&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="282" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_3" value='&lt;b&gt;3.3&lt;/b&gt;&lt;hr size="1"&gt;รับและตรวจสอบ consent (key · schema · idempotency)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST /public/v1/consents&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="282" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_4" value='&lt;b&gt;3.4&lt;/b&gt;&lt;hr size="1"&gt;บันทึก transaction + receipt และอัปเดตสถานะ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;1 DB transaction&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="282" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_5" value='&lt;b&gt;3.5&lt;/b&gt;&lt;hr size="1"&gt;เผยแพร่ event และ sync ระบบปลายทาง&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;outbox → webhook&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1240" y="282" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_6" value='&lt;b&gt;3.6&lt;/b&gt;&lt;hr size="1"&gt;Preference center และการถอน' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="495" y="632" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_7" value='&lt;b&gt;3.7&lt;/b&gt;&lt;hr size="1"&gt;ตรวจวันหมดอายุ และ re-consent&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;River cron&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1095" y="632" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_p3_8" value='&lt;b&gt;3.8&lt;/b&gt;&lt;hr size="1"&gt;กระทบยอดกับระบบปลายทาง และรายงาน&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;River cron&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1395" y="632" width="190" height="96" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_1" value='&lt;b&gt;D3.1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Purpose catalog&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;data_elements · purposes · purpose_versions · preferences&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="200" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_2" value='&lt;b&gt;D3.2&lt;/b&gt;&amp;nbsp;&amp;nbsp;Collection point / แบนเนอร์&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;collection_points · cookie.banner_configs · cookies&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="462" width="200" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_3" value='&lt;b&gt;D3.3&lt;/b&gt;&amp;nbsp;&amp;nbsp;เจ้าของข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;data_subjects · subject_identifiers (blind index)&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="462" width="200" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_4" value='&lt;b&gt;D3.4&lt;/b&gt;&amp;nbsp;&amp;nbsp;Consent ledger (append-only)&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;consent_receipts · consent_transactions ⟨P⟩ · cookie.consent_records ⟨P⟩&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="462" width="200" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_5" value='&lt;b&gt;D3.5&lt;/b&gt;&amp;nbsp;&amp;nbsp;สถานะล่าสุด (projection)&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;consent_status&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="462" width="200" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_6" value='&lt;b&gt;D3.6&lt;/b&gt;&amp;nbsp;&amp;nbsp;Outbox / sync log&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;platform.outbox_events · webhook_deliveries · downstream_syncs&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1540" y="462" width="220" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3_D3_7" value='&lt;b&gt;D3.7&lt;/b&gt;&amp;nbsp;&amp;nbsp;Reconcile / campaign&lt;br&gt;&lt;font style="font-size:9px" color="#7F6000"&gt;reconcile_runs · reconcile_items · campaigns&lt;/font&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1310" y="842" width="230" height="46" as="geometry"/></mxCell><mxCell id="dfd2_3-v3" value="DPO / ผู้ดูแลระบบ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="45" y="132" width="180" height="56" as="geometry"/></mxCell><mxCell id="dfd2_3-v4" value="เว็บไซต์ / แอป (SDK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="345" y="132" width="180" height="56" as="geometry"/></mxCell><mxCell id="dfd2_3-v5" value="เจ้าของข้อมูล / ผู้ปกครอง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="645" y="132" width="180" height="56" as="geometry"/></mxCell><mxCell id="dfd2_3-v6" value="CRM / CDP / Marketing (ระบบปลายทาง)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="132" width="200" height="56" as="geometry"/></mxCell><mxCell id="dfd2_3-v7" value="เจ้าของข้อมูล *" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="500" y="832" width="180" height="56" as="geometry"/></mxCell><mxCell id="dfd2_3-v8" value="การตลาด / DPO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="1040" y="832" width="180" height="56" as="geometry"/></mxCell><mxCell id="dfd2_3-v36" value="&lt;b&gt;สัญลักษณ์ (Gane-Sarson)&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1820" y="92" width="260" height="20" as="geometry"/></mxCell><mxCell id="dfd2_3-v37" value="External entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;shadow=1;" vertex="1" parent="1"><mxGeometry x="1820" y="118" width="120" height="34" as="geometry"/></mxCell><mxCell id="dfd2_3-v38" value='&lt;b&gt;n.n&lt;/b&gt;&lt;hr size="1"&gt;Process' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;strokeWidth=2;arcSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1960" y="114" width="110" height="50" as="geometry"/></mxCell><mxCell id="dfd2_3_Dn" value="&lt;b&gt;Dn&lt;/b&gt;&amp;nbsp;&amp;nbsp;Data store" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=1;right=0;top=1;bottom=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1820" y="176" width="160" height="30" as="geometry"/></mxCell><mxCell id="dfd2_3-v41" value="&lt;b&gt;หมายเหตุสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• 3.3 + 3.4 ทำใน DB transaction เดียว: INSERT transaction + UPSERT consent_status + INSERT outbox_events&lt;br&gt;• idempotency: unique (tenant_id, idempotency_key) ใน consent_transactions — คำขอซ้ำคืนผลเดิม&lt;br&gt;• identifier เก็บแบบเข้ารหัส (value_enc) + blind_index (HMAC) สำหรับค้นหาแบบตรงตัว&lt;br&gt;• 3.5 worker อ่าน outbox (FOR UPDATE SKIP LOCKED) ส่ง webhook และบันทึก delivery; retry 1 นาที → 24 ชม.&lt;br&gt;• D3.5 เป็น projection สร้างใหม่ได้จาก D3.4 (rebuild job) — ห้ามแก้ D3.4 ย้อนหลัง&lt;br&gt;• * = entity ซ้ำเพื่อลดเส้นตัดกัน" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1820" y="302" width="340" height="184" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dfd2_7" name="DFD-2.7 Level 2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="928" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dfd2_7-e7" value="คำขอ + ข้อมูลติดต่อ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dfd2_7-v3" target="dfd2_7_p7_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dfd2_7-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="dfd2_7_p7_1" target="dfd2_7_D7_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dfd2_7-e9" value="คำขอใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dfd2_7_p7_1" target="dfd2_7_p7_2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="dfd2_7-e10" value="OTP / เอกสาร" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dfd2_7-v3" target="dfd2_7_p7_2"><mxGeometry relative="1" as="geometry"><Array as="points"><