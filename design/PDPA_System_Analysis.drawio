BRE-01 ถึง BRE-17" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp07_s" value="พบ / สงสัยว่ามีเหตุละเมิด" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp07_t1" value="แจ้งเหตุผ่านฟอร์ม / อีเมล / SIEM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t2" value='สร้าง incident + บันทึกเวลาที่ทราบเหตุ + เริ่มนับ 72 ชม.&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST /api/v1/breach/incidents&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t3" value='ควบคุมเหตุ (containment) + เก็บหลักฐาน&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;evidence · response_tasks&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t4" value='ประเมินความเสี่ยงต่อสิทธิและเสรีภาพ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;breach.assessments&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="398.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_g1" value="มีความเสี่ยง?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1001.0" y="410.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp07_t5" value="บันทึกเหตุ + เหตุผลที่ไม่ต้องแจ้ง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_e1" value="ปิด (ไม่ต้องแจ้ง)" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1173.0" y="532.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp07_t6" value="จัดทำแบบแจ้ง สคส." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="398.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_g2" value="เกิน 72 ชม.?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1337.0" y="410.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp07_t7" value="ระบุเหตุผลความล่าช้า (ไม่เกิน 15 วัน)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t8" value='ส่ง / บันทึกการแจ้ง สคส. + หลักฐาน&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;pdpc_notifications&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t9" value="สคส. รับแจ้ง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="902.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_g3" value="เสี่ยงสูง?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1673.0" y="410.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp07_t10" value='แจ้งเจ้าของข้อมูล + แนวทางเยียวยา&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;subject_notifications&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t11" value="เจ้าของข้อมูลได้รับแจ้ง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="902.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t12" value='แก้ไข ฟื้นฟู วิเคราะห์ root cause&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;root_causes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1957.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_t13" value="ปิดเหตุ + บทเรียน + ปรับมาตรการ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2125.0" y="398.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp07_e" value="ปิด" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2349.0" y="414.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp07_m1" value="เตือน T+24 / 48 / 66 ชม." style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="669.0" y="784.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp07-v29" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• แจ้ง สคส. โดยไม่ชักช้าภายใน 72 ชม. นับแต่ทราบเหตุ เว้นแต่เหตุนั้นไม่มีความเสี่ยงที่จะกระทบสิทธิและเสรีภาพ (ม.37(4))&lt;br&gt;• ถ้ามีความเสี่ยงสูง ต้องแจ้งเจ้าของข้อมูลพร้อมแนวทางการเยียวยาโดยไม่ชักช้า (ม.37(4))&lt;br&gt;• แจ้งเกิน 72 ชม. ต้องชี้แจงเหตุผลความล่าช้า โดยไม่เกิน 15 วันนับแต่ทราบเหตุ (ประกาศแจ้งเหตุละเมิด พ.ศ. 2565)&lt;br&gt;• ผู้ประมวลผลต้องแจ้งผู้ควบคุมข้อมูลโดยไม่ชักช้า (ม.40) → ช่องทางแจ้งเหตุของคู่ค้า&lt;br&gt;• timeline_events เป็น append-only ทุกการเปลี่ยนสถานะ ใช้เป็นหลักฐานต่อ สคส." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1028" width="1116" height="105" as="geometry"/></mxCell><mxCell id="bp07-v30" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• breach.incidents · incident_assets · assessments&lt;br&gt;• breach.evidence · timeline_events · response_tasks · root_causes&lt;br&gt;• breach.pdpc_notifications · subject_notifications · notification_recipients&lt;br&gt;• breach.routing_rules · playbooks" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1176" y="1028" width="655" height="92" as="geometry"/></mxCell><mxCell id="bp07-v31" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /api/v1/breach/incidents (SIEM) · POST /public/v1/breach-reports&lt;br&gt;• event: breach.reported · breach.assessed · breach.pdpc_notified&lt;br&gt;• event: breach.subjects_notified · breach.closed&lt;br&gt;• job: breach.sla_timer (T+24/48/66 ชม.)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1851" y="1028" width="617" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp08" name="BP-08 ประเมินผลกระทบด้านการคุ้มครองข้อมูล"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1173" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp08-v3" value="เจ้าของโครงการ / กระบวนการ" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2260" height="134" as="geometry"/></mxCell><mxCell id="bp08-v4" value="PDPA Platform · Assessment" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="2260" height="252" as="geometry"/></mxCell><mxCell id="bp08-v5" value="IT / Security" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mx