#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_SCHED" target="uc05_PNG-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e16" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_DPO" target="uc05_PNG-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e17" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_DPO" target="uc05_PNG-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e18" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_DS" target="uc05_PNG-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e19" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_OWNER" target="uc05_PNG-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e20" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_SCHED" target="uc05_PNG-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e21" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_DS" target="uc05_PNG-04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e22" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_DS" target="uc05_PNG-09"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e23" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_DPO" target="uc05_PNG-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e24" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc05_a_WEB" target="uc05_PNG-08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e25" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc05_PNG-01" target="uc05_PNG-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-e26" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc05_PNG-01" target="uc05_PNG-05"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="862" y="227.0"/><mxPoint x="862" y="503.0"/></Array></mxGeometry></mxCell><mxCell id="uc05-e27" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc05_PNG-10" target="uc05_PNG-01"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="892" y="595.0"/><mxPoint x="892" y="227.0"/></Array></mxGeometry></mxCell><mxCell id="uc05-e28" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc05_PNG-03" target="uc05_PNG-01"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="411.0"/><mxPoint x="922" y="227.0"/></Array></mxGeometry></mxCell><mxCell id="uc05-e29" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc05_PNG-08" target="uc05_PNG-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc05-v1" value="UC-05  Use Case — PNG: ระบบจัดการประกาศความเป็นส่วนตัวแบบอัตโนมัติ (Privacy Notice Generator)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="uc05-v2" value="ขอบเขต: สร้าง เผยแพร่ และติดตามประกาศความเป็นส่วนตัวและนโยบายที่เกี่ยวข้อง&lt;br&gt;16 use cases · Must 7 · Should 8 · Nice 1 · รหัส use case = Function ID ใน Development Plan (ดู acceptance criteria และ task ได้จากรหัสเดียวกัน) · Pn = phase ที่พัฒนา" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="58" as="geometry"/></mxCell><mxCell id="uc05_PNG-01" value='&lt;b&gt;PNG-01&lt;/b&gt; สร้างประกาศแบบถาม-ตอบ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Wizard-based generator · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-02" value='&lt;b&gt;PNG-02&lt;/b&gt; ตรวจเนื้อหาครบตาม ม.23&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Mandatory content checklist · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="286" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-03" value='&lt;b&gt;PNG-03&lt;/b&gt; แม่แบบตามกลุ่มเจ้าของข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Templates by data subject · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-05" value='&lt;b&gt;PNG-05&lt;/b&gt; ประกาศสองภาษา&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;TH/EN notices · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-10" value='&lt;b&gt;PNG-10&lt;/b&gt; ดึงเนื้อหาจาก RoPA&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Auto-populate from RoPA · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="562" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-11" value='&lt;b&gt;PNG-11&lt;/b&gt; แม่แบบตามอุตสาหกรรม&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Industry templates · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="654" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-12" value='&lt;b&gt;PNG-12&lt;/b&gt; ประกาศแบบหลายชั้นและป้าย CCTV&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Layered notice &amp;amp; CCTV signage · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="746" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-13" value='&lt;b&gt;PNG-13&lt;/b&gt; ลิงก์เอกสารอ้างอิงในประกาศ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Linked documents · P4&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="838" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-16" value='&lt;b&gt;PNG-16&lt;/b&gt; สร้างนโยบายความเป็นส่วนตัวและนโยบายคุกกี้&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Privacy &amp;amp; cookie policy generator · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-06" value='&lt;b&gt;PNG-06&lt;/b&gt; จัดการเวอร์ชัน&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Versioning · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1022" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-15" value='&lt;b&gt;PNG-15&lt;/b&gt; แจ้งเตือนทบทวนตามรอบ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Periodic review reminder · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="1114" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-07" value='&lt;b&gt;PNG-07&lt;/b&gt; แจ้งการเปลี่ยนแปลงและขอความยินยอมใหม่&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Change notification · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1206" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-04" value='&lt;b&gt;PNG-04&lt;/b&gt; ประกาศกรณีเก็บจากแหล่งอื่น&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Indirect collection notice · P1&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="1298" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc05_PNG-09" value='&lt;b&gt;PNG-09&lt;/