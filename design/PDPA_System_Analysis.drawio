 x="-1" as="geometry"><mxPoint x="385.0" y="386" as="sourcePoint"/><mxPoint x="615.0" y="386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e19" value="&lt;b&gt;6.&lt;/b&gt; หา data_subject ด้วย blind_index (สร้างใหม่ถ้าไม่พบ)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="424" as="sourcePoint"/><mxPoint x="615.0" y="424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e20" value="&lt;b&gt;7.&lt;/b&gt; ตรวจ purpose_versions ที่ active · เงื่อนไขผู้เยาว์" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="462" as="sourcePoint"/><mxPoint x="615.0" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e21" value="&lt;b&gt;8.&lt;/b&gt; INSERT consent_receipts (prev_hash → hash) · consent_transactions × n" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="500" as="sourcePoint"/><mxPoint x="615.0" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e22" value="&lt;b&gt;9.&lt;/b&gt; UPSERT consent_status · INSERT outbox_events (consent.granted ฯลฯ)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="538" as="sourcePoint"/><mxPoint x="615.0" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e23" value="&lt;b&gt;10.&lt;/b&gt; COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="576" as="sourcePoint"/><mxPoint x="615.0" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e24" value="&lt;b&gt;11.&lt;/b&gt; 201 {receipt_no, transactions[]}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=none;strokeColor=#7F7F7F;fontColor=#404040;align=right;spacingRight=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="385.0" y="614" as="sourcePoint"/><mxPoint x="155.0" y="614" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e25" value="&lt;b&gt;12.&lt;/b&gt; SELECT outbox … FOR UPDATE SKIP LOCKED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=right;spacingRight=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="845.0" y="652" as="sourcePoint"/><mxPoint x="615.0" y="652" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e26" value="&lt;b&gt;13.&lt;/b&gt; POST webhook · X-Signature: t=…, v1=HMAC-SHA256" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="845.0" y="690" as="sourcePoint"/><mxPoint x="1075.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e27" value="&lt;b&gt;14.&lt;/b&gt; 2xx" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=none;strokeColor=#7F7F7F;fontColor=#404040;align=right;spacingRight=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="1075.0" y="762" as="sourcePoint"/><mxPoint x="845.0" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e28" value="&lt;b&gt;15.&lt;/b&gt; webhook_deliveries = delivered" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=right;spacingRight=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="845.0" y="800" as="sourcePoint"/><mxPoint x="615.0" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-e29" value="&lt;b&gt;16.&lt;/b&gt; failed · next_retry_at ตาม backoff (1 นาที → 24 ชม.)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=none;align=right;spacingRight=6;" edge="1" parent="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="845.0" y="858" as="sourcePoint"/><mxPoint x="615.0" y="858" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq04-v1" value="SEQ-04  Sequence — Consent API: idempotency + transaction + outbox + webhook" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1800" height="34" as="geometry"/></mxCell><mxCell id="seq04-v2" value="ระบบช่องทาง (CRM / POS / แอป) ส่ง consent ผ่าน /api/v1 · ระบบปลายทางได้รับ event ผ่าน webhook ที่ลงลายมือชื่อ HMAC" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1800" height="22" as="geometry"/></mxCell><mxCell id="seq04-v9" value='&lt;font color="#404040"&gt;[เคยประมวลผล key นี้แล้ว]&lt;/font&gt;' style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="105.0" y="292" width="370.0" height="18" as="geometry"/></mxCell><mxCell id="seq04-v11" value='&lt;font color="#404040"&gt;[ตอบ 2xx]&lt;/font&gt;' style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="565.0" y="720" width="600.0" height="18" as="geometry"/></mxCell><mxCell id="seq04-v13" value='&lt;font color="#404040"&gt;[error / timeout]&lt;/font&gt;' style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="521.0" y="833" width="640.0" height="18" as="geometry"/></mxCell><mxCell id="seq04-v15" value="&lt;b&gt;2.&lt;/b&gt; authn client · ตรวจ schema ตาม OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#BF9000;fontSize=10;align=left;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="391.0" y="218" width="214" height="22" as="geometry"/></mxCell><mxCell id="seq04-v30" value="&lt;b&gt;17.&lt;/b&gt; ครบ 24 ชม. → dead + แจ้ง DPO + เข้าคิว reconcile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#BF9000;fontSize=10;align=left;spacingLeft=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="851.0" y="884" width="214" height="36" as="geometry"/></mxCell><mxCell id="seq04-v31" value="&lt;b&gt;หมายเหตุสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• Idempotency-Key เก็บ 24 ชม. (unique tenant_id + key) · body ต่างจากเดิม → 422&lt;br&gt;• receipt hash = SHA-256(prev_hash + canonical JSON) ตรวจ chain ย้อนหลังได้&lt;br&gt;• ขั้น 5–10 อยู่ใน transaction เดียว: ถ้า fail ไม่มี event หลุดออกไป (outbox)&lt;br&gt;• ผู้รับ webhook ตรวจ timestamp ≤ 5 นาที และ event id ซ้ำ (idempotent)&lt;br&gt;• rate limit ต่อ client ตาม api_clients.rate_limit_per_min&lt;br&gt;• OAuth2 client credentials · scope ที่ต้องมี: consent.record.create" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1210.0" y="102" width="360" height="158" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq05" name="SEQ-05 DSAR + OTP"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="932" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq05-v3" value="เจ้าของข้อมูล" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursive