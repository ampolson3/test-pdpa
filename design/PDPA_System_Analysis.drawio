t="bp05_t8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp05-e18" value="แก้แล้วส่งตรวจใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp05_t8" target="bp05_t4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1528.0" y="130.0"/><mxPoint x="856.0" y="130.0"/></Array></mxGeometry></mxCell><mxCell id="bp05-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp05_t9" target="bp05_m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp05-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp05_m1" target="bp05_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp05-v1" value="BP-05  Business Process — จัดทำและอนุมัติ RoPA (Record of Processing Activities)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp05-v2" value="Trigger: กิจกรรมใหม่ / เปลี่ยนระบบ ผู้รับข้อมูล หรือการโอน / รอบทบทวนประจำปี · ผลลัพธ์: RoPA ที่อนุมัติ เชื่อมกับ data map, notice, risk และ DPIA · UC: ROPA-01 ถึง ROPA-20, RTG-04 ถึง RTG-07" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="40" as="geometry"/></mxCell><mxCell id="bp05_s" value="กิจกรรมใหม่ / เปลี่ยนแปลง" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="164.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp05_t1" value="เลือกวิธีสร้าง: template / wizard / import Excel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="148.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_t2" value='สร้าง draft + prefill&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;generation_runs · wizard_sessions&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="277.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp05_t3" value="กรอกวัตถุประสงค์ ข้อมูล ฐานกฎหมาย ผู้รับ การโอน ระยะเวลาเก็บ มาตรการ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="148.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_t4" value="ตรวจความครบถ้วนตาม ม.39 และกฎข้อมูลอ่อนไหว ม.26" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="282.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_t5" value='คำนวณคะแนนความเสี่ยง&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;risk.activity_scores&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="282.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_g1" value="เข้าเกณฑ์ DPIA?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1169.0" y="294.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp05_t6" value='สร้าง DPIA screening (→ BP-08)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;assess.assessments&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="400.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_t7" value="ทบทวน RoPA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="534.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_g2" value="อนุมัติ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1505.0" y="546.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp05_t8" value='แก้ไขตามเหตุผลที่ส่งกลับ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;activity_rejections&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="148.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp05_t9" value='publish version + อัปเดต data map / notice / register&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;record_versions · dataflow.snapshots&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="277.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp05_m1" value="ทบทวนทุก 12 เดือน" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1845.0" y="298.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp05_e" value="RoPA มีผล" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2013.0" y="298.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp05-v21" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• RoPA ต้องมีอย่างน้อย: ข้อมูลที่เก็บ, วัตถุประสงค์, ข้อมูลผู้ควบคุมข้อมูล, ระยะเวลาเก็บ, สิทธิและวิธีเข้าถึง, การใช้/เปิดเผยตาม ม.27, การปฏิเสธคำขอหรือคัดค้าน, มาตรการรักษาความปลอดภัย (ม.39)&lt;br&gt;• ข้อมูลอ่อนไหวต้องระบุข้อยกเว้นตาม ม.26 หรือความยินยอมโดยชัดแจ้ง ไม่เช่นนั้นส่งอนุมัติไม่ได้&lt;br&gt;• กิจการขนาดเล็กอาจได้รับยกเว้นบางรายการตามประกาศ สคส. (บันทึกผลตรวจใน sme_exemption_checks)&lt;br&gt;• ผู้ประมวลผลจัดทำบันทึกรายการตามประกาศ สคส. ว่าด้วยบันทึกรายการของผู้ประมวลผล&lt;br&gt;• ทุกการแก้ไขสร้าง record_versions + audit log; ทบทวนอย่างน้อยปีละครั้ง (นโยบาย)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="962" height="105" as="geometry"/></mxCell><mxCell id="bp05-v22" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• ropa.processing_activities · activity_purposes · activity_data&lt;br&gt;• ropa.activity_systems · activity_recipients · activity_transfers&lt;br&gt;• ropa.retention_rules · activity_controls · activity_rejections&lt;br&gt;• ropa.template_sets · activity_templates · generation_runs · wizard_sessions&lt;br&gt;• risk.activity_scores · platform.record_versions · approvals" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1022" y="660" width="564" height="105" as="geometry"/></mxCell><mxCell id="bp05-v23" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /admin/v1/ropa/activities · PATCH …/{id}&lt;br&gt;• POST /admin/v1/ropa/activities/{id}/submit · /approve · /reject&lt;br&gt;• POST /admin/v1/ropa/imports (Excel)&lt;br&gt;• event: ropa.activity_submitted · ropa.activity_approved · risk.dpia_required" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1606" y="660" width="526" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp06" name="BP-06 จัดการคำขอใช้สิทธิของเจ้าของข้อมูล"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1039" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp06-v3" value="เจ้าของข้อมูล / ผู้แทน" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2260" height="134" as="geometry"/></mxCell><mxCell id="bp06-v4" value="PDPA Platform · DSAR" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="2260" height="252" as="geometry"/></mxCell><mxCell id="bp06-v5" value="DPO / Privacy team" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x=