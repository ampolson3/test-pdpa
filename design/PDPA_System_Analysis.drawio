y="287.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc11_a_SEC" value="ทีม Security / Incident&lt;br&gt;&lt;i&gt;(Security / Incident Response)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="471.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc11_a_ORGADMIN" value="ผู้ดูแลระบบขององค์กร&lt;br&gt;&lt;i&gt;(Organization Admin)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="609.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc11_a_DPO" value="DPO / Privacy Team&lt;br&gt;&lt;i&gt;(DPO / Privacy Team)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="701.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc11_a_EXEC" value="ผู้บริหาร / ผู้มีอำนาจอนุมัติ&lt;br&gt;&lt;i&gt;(Executive / Approver)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="1161.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc11_a_PDPC" value="สคส.&lt;br&gt;&lt;i&gt;(PDPC (Regulator))&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1110" y="563.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc11_a_SCHED" value="ระบบ: Scheduler / Event&lt;br&gt;&lt;i&gt;(System Timer &amp;amp; Events)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outl