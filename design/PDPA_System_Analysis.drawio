xCell id="st01-e19" value="EXPIRED [now ≥ expires_at]&lt;br&gt;/ job expiry_sweep" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="st01-v6" target="st01-v9"><mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint x="-7.6" y="18.5" as="offset"/></mxGeometry></mxCell><mxCell id="st01-e20" value="CONSENTED / EXTENDED" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;exitX=0;exitY=0.05;exitDx=0;exitDy=0;entryX=1;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="st01-v9" target="st01-v6"><mxGeometry relative="1" x="-0.4" as="geometry"><mxPoint x="5.3" y="-13.0" as="offset"/></mxGeometry></mxCell><mxCell id="st01-e21" value="EXTENDED · CHANGED_PREFERENCES" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st01-v6" target="st01-v6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/><Array as="points"><mxPoint x="726" y="447"/><mxPoint x="794" y="447"/></Array></mxGeometry></mxCell><mxCell id="st01-v1" value="ST-01  State Machine — สถานะความยินยอม (consent.consent_status.status)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="34" as="geometry"/></mxCell><mxCell id="st01-v2" value="หนึ่งแถวต่อ เจ้าของข้อมูล × purpose · ข้อความบนเส้น = consent_transactions.transaction_type ที่ทำให้เปลี่ยนสถานะ (บันทึกใน tx เดียวกับ UPSERT สถานะและ outbox event)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1700" height="22" as="geometry"/></mxCell><mxCell id="st01-v3" value="&lt;b&gt;Consent status&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="900" height="24" as="geometry"/></mxCell><mxCell id="st01-v4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="350" width="24" height="24" as="geometry"/></mxCell><mxCell id="st01-v5" value='&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;รอยืนยัน double opt-in / ผู้ปกครอง&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285.0" y="183.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st01-v6" value='&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ยินยอมและมีผล&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="675.0" y="333.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st01-v7" value='&lt;b&gt;NOT_GIVEN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ไม่ยินยอม / ยกเลิก&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285.0" y="493.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st01-v8" value='&lt;b&gt;WITHDRAWN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ถอนความยินยอมแล้ว&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1065.0" y="183.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st01-v9" value='&lt;b&gt;EXPIRED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ครบอายุ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1065.0" y="493.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="st01-v22" value="&lt;b&gt;กติกาสำหรับนักพัฒนา&lt;/b&gt;&lt;br&gt;• ทุก transition = INSERT consent_transactions + UPSERT consent_status + INSERT outbox_events ใน DB tx เดียว&lt;br&gt;• ห้าม UPDATE status ตรง ๆ โดยไม่มี transaction (เขียนได้จาก consent service เท่านั้น)&lt;br&gt;• EXPIRED ถูกตั้งโดย job consent.expiry_sweep (River cron รายวัน)&lt;br&gt;• ความยินยอมผู้เยาว์: PENDING จนกว่า guardian_approvals = approved&lt;br&gt;• สถานะที่ถือว่าประมวลผลได้: ACTIVE เท่านั้น" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1330" y="102" width="380" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="st02" name="ST-02 DSAR request"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="811" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st02-v4" value="Open (ยังไม่ปิด)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=none;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="252" width="1045" height="380" as="geometry"/></mxCell><mxCell id="st02-e17" value="ยื่นคำขอ&lt;br&gt;/ เริ่ม SLA" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st02-v5" target="st02-v6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="st02-e18" value="ส่ง OTP / ขอเอกสาร" style="html=1;endArrow=open;endFill=0;endSiz