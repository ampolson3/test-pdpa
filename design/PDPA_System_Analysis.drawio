eometry"></mxGeometry></mxCell><mxCell id="bp04-v1" value="BP-04  Business Process — จัดทำและเผยแพร่ประกาศความเป็นส่วนตัว (Privacy notice lifecycle)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp04-v2" value="Trigger: ประกาศใหม่ / แก้ไขประกาศ / เก็บข้อมูลจากแหล่งอื่น · ผลลัพธ์: ประกาศเวอร์ชันที่อนุมัติแล้ว เผยแพร่ และมีหลักฐานการแจ้ง · UC: PNG-01 ถึง PNG-16" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp04_s" value="ต้องการประกาศใหม่ / แก้ไข" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp04_t1" value="เลือก wizard / template ตามกลุ่มบุคคล" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_t2" value='ดึงวัตถุประสงค์ ฐานกฎหมาย ระยะเวลาเก็บ ผู้รับข้อมูล จาก RoPA&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;notice_activity_links&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_t3" value="แก้ไขเนื้อหา TH / EN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_t4" value="ตรวจรายการบังคับตาม ม.23" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_g1" value="ครบถ้วน?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1001.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp04_t5" value="ทบทวน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_g2" value="อนุมัติ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1337.0" y="528.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp04_t6" value='publish เวอร์ชันใหม่ (immutable) + hosted URL / embed&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;notice_versions · embeds&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_g3" value="เปลี่ยนสาระสำคัญ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1673.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp04_t7" value="แจ้งเจ้าของข้อมูล / ขอรับทราบใหม่" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_t8" value='รับทราบประกาศ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;acknowledgements&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_e1" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2013.0" y="666.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp04_e0" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1677.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp04_s2" value="ได้ข้อมูลจากแหล่งอื่น" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp04_t9" value='บันทึกการเก็บจากแหล่งอื่น&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;indirect_collections&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="382.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_m1" value="ภายใน 30 วัน" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="501.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp04_t10" value="แจ้งรายละเอียดตาม ม.23 + แหล่งที่มา" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="382.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_t11" value="ได้รับแจ้ง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp04_e2" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="837.0" y="666.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp04-v27" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• แจ้งก่อนหรือขณะเก็บข้อมูล: วัตถุประสงค์และฐานกฎหมาย, ผลกระทบกรณีไม่ให้ข้อมูลที่จำเป็นตามกฎหมาย/สัญญา, ข้อมูลที่เก็บและระยะเวลาเก็บ, ผู้รับข้อมูล, ข้อมูลติดต่อผู้ควบคุมข้อมูลและ DPO, สิทธิของเจ้าของข้อมูล (ม.23)&lt;br&gt;• เก็บข้อมูลจากแหล่งอื่นต้องแจ้งเจ้าของข้อมูลภายใน 30 วันนับแต่วันที่เก็บ (ม.25) เว้นแต่เข้าข้อยกเว้น&lt;br&gt;• ใช้ข้อมูลเพื่อวัตถุประสงค์ใหม่ต้องแจ้งและขอความยินยอมก่อน เว้นแต่มีฐานอื่นตามกฎหมาย (ม.21)&lt;br&gt;• ทุกเวอร์ชันแก้ไขไม่ได้หลัง publish; เก็บหลักฐานว่าแสดงเวอร์ชันใดแก่ใคร เมื่อใด&lt;br&gt;• ประกาศต้องมีภาษาไทยเป็นอย่างน้อย และแสดงวันที่มีผลบังคับ" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="962" height="118" as="geometry"/></mxCell><mxCell id="bp04-v28" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• notice.notices · notice_versions&lt;br&gt;• notice.notice_activity_links → ropa.processing_activities&lt;br&gt;• notice.acknowledgements · embeds · linked_documents&lt;br&gt;• notice.indirect_collections · wizard_templates" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1022" y="776" width="564" height="92" as="geometry"/></mxCell><mxCell id="bp04-v29" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• GET /public/v1/notices/{slug} (hosted / embed)&lt;br&gt;• POST /public/v1/notices/{id}/acknowledgements&lt;br&gt;• event: notice.published · notice.material_change&lt;br&gt;• job: notice.indirect_due (แจ้งเตือนก่อนครบ 30 วัน)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1606" y="776" width="526" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp05" name="BP-05 จัดทำและอนุมัติ RoPA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2172" pageHeight="805" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp05-v3" value="เจ้าของกระบวนการ / Champion" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="2092" height="134" as="geometry"/></mxCell><mxCell id="bp05-v4" value="PDPA Platform · RoPA" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;font