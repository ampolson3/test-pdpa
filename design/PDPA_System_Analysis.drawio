eometry></mxCell><mxCell id="bp03-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp03_t9" target="bp03_t10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1024.0" y="701.0"/></Array></mxGeometry></mxCell><mxCell id="bp03-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp03_t10" target="bp03_x1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp03-v1" value="BP-03  Business Process — แบนเนอร์คุกกี้และการสแกนเว็บไซต์ (Cookie consent &amp;amp; scanning)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp03-v2" value="Trigger: ผู้เข้าชมเปิดเว็บไซต์ / รอบสแกนตามกำหนด · ผลลัพธ์: บล็อกสคริปต์จนกว่าจะยินยอม บันทึกหลักฐาน และแบนเนอร์ตรงกับคุกกี้จริง · UC: CON-01 ถึง CON-08" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp03_s" value="เปิดเว็บไซต์" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp03_t1" value='โหลด SDK + banner config&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;GET /public/v1/cookie/banners/{domainKey}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="259.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp03_t1b" value="ตอบจาก CDN cache (ETag)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="398.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_g1" value="มี consent เดิมและ version ตรง?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="497.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp03_t2" value="บล็อกสคริปต์ที่ไม่จำเป็น + แสดงแบนเนอร์" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_t3" value="ยอมรับทั้งหมด / ปฏิเสธทั้งหมด / ตั้งค่ารายหมวด" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_t4" value="เก็บ consent cookie + ส่งหลักฐาน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_t5" value='บันทึก consent_records (partition รายเดือน)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST /public/v1/cookie/consents&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="393.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp03_t6" value="เปิดสคริปต์ตามหมวด + Consent Mode v2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_e1" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1341.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp03_m1" value="ตามรอบ / สั่งสแกน" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="548.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp03_t7" value='crawl ด้วย headless Chrome&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;scanner (chromedp) · cookie.scans&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="527.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp03_t8" value='จับคู่ cookie_kb + จัดหมวดอัตโนมัติ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;scan_findings&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="532.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_g2" value="พบคุกกี้ใหม่ / ไม่ทราบหมวด?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="665.0" y="544.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp03_t9" value="ตรวจ จัดหมวด อนุมัติแบนเนอร์" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="666.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_e2" value="ไม่มีการเปลี่ยนแปลง" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="837.0" y="548.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp03_t10" value='publish banner version ใหม่ + purge CDN&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;banner_configs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="532.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp03_x1" value="ผู้เข้าชมถูกขอความยินยอมใหม่ในการเข้าชมครั้งถัดไป" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="1173.0" y="548.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp03-v25" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• คุกกี้ที่จำเป็น (strictly necessary) ไม่ต้องขอความยินยอม หมวดอื่นต้องบล็อกไว้จนกว่าจะได้รับความยินยอม (prior blocking)&lt;br&gt;• ปุ่มปฏิเสธทั้งหมดต้องเห็นชัดเท่ากับปุ่มยอมรับทั้งหมด และไม่ใช้ dark pattern (แนวปฏิบัติที่ดี)&lt;br&gt;• เพิ่มคุกกี้ใหม่หรือเปลี่ยนหมวด → banner version ใหม่ → ขอความยินยอมใหม่&lt;br&gt;• หลักฐานเก็บ: domain, banner version, หมวดที่เลือก, เวลา, hash ของ IP / User-Agent (ไม่เก็บ IP เต็มถ้าไม่จำเป็น)&lt;br&gt;• อายุ consent cookie ตั้งได้ต่อโดเมน (ค่าเริ่มต้น 12 เดือน) — หมดอายุแล้วแสดงแบนเนอร์ใหม่" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="690" height="105" as="geometry"/></mxCell><mxCell id="bp03-v26" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• cookie.domains · apps · banner_configs · ab_variants&lt;br&gt;• cookie.categories · cookies · cookie_kb · script_rules&lt;br&gt;• cookie.scans · scan_findings&lt;br&gt;• cookie.consent_records ⟨P⟩" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="792" width="405" height="92" as="geometry"/></mxCell><mxCell id="bp03-v27" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• GET /public/v1/cookie/banners/{domainKey} (CDN cache 5 นาที)&lt;br&gt;• POST /public/v1/cookie/consents (rate limit ต่อ IP)&lt;br&gt;• POST /admin/v1/cookie/domains/{id}/scans&lt;br&gt;• event: cookie.scan_completed · cookie.banner_published" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1175" y="792" width="365" height="92" as="geometry"/></mxCell><mxCell id="bp03-v28" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1490" y="98" width="200" height="20" as="geometry"/></mxCell><mxCell id="bp03-v29" value="" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1490" y="126" width="26" height="26" as="geometry"/></mxCell><mxCell id="bp03-v30" value="เริ่มต้น" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1524" y="126" width="160" height="26" as="geometry"/></mxCell><mxCell id="bp03-v31" value="" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1490" y="170" width="26" height="26" as="geometry"/></mxCell><mxCell id="bp03-v32" value="สิ้นสุด" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1524" y="170" width="160" height="26" as="geometry"/></mxCell><mxCell id="bp03-v33" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1490" y="214" width="26" height="26" as="geometry"/></mxCell><mxCell id="bp03-v34" value="ตัวตั้งเวลา / SLA" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1524" y="214" width="160" height="26" as="geometry"/></mxCell><mxCell id="bp03-v35" value="งานของคน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="258" width="90" height="36" as="geometry"/></mxCell><mxCell id="bp03-v36" value="งานของระบบ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1590" y="258" width="90" height="36" as="geometry"/></mxCell><mxCell id="bp03-v37" value="" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1490" y="306" width="30" height