okeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="1192.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc05_a_DS" value="เจ้าของข้อมูล / ผู้เข้าชมเว็บ&lt;br&gt;&lt;i&gt;(Data Subject / Visitor)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1200" y="1448.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc05_a_WEB" value="เว็บไซต์ / แอปขององค์กร (SDK)&lt;br&gt;&lt;i&gt;(Website / App with SDK)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1200" y="1576.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc05_a_SCHED" value="ระบบ: Scheduler / Event&lt;br&gt;&lt;i&gt;(System Timer &amp;amp; Events)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1200" y="1320.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc05-v30" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1460" y="138" width="260" height="22" as="geometry"/></mxCell><mxCell id="uc05-v31" value="Must — กฎหมายกำหนด / จำเป็น" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="166" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc05-v32" value="Should — มาตรฐานตลาด" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="212" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc05-v33" value="Nice-to-have — จุดขายเพิ่ม" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="258" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc05-v34" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1468" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc05-v35" value="ผู้ใช้ภายในองค์กร" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1448" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc05-v36" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1552" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc05-v37" value="บุคคล / หน่วยงานภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1532" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc05-v38" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1636" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc05-v39" value="ระบบ / บริการภายนอก" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1616" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc05-v40" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;&lt;br&gt;• เส้นทึบ = actor ใช้งาน use case&lt;br&gt;• «include» = use case ต้นทางเรียกใช้ปลายทางทุกครั้ง&lt;br&gt;• «extend» = ส่วนขยายที่เกิดตามเงื่อนไข ชี้ไปยัง use case หลัก&lt;br&gt;• สีวงรี = ความสำคัญ (Must / Should / Nice)&lt;br&gt;• Pn = phase ในแผนพัฒนา (P0–P4)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="396" width="260" height="131" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="uc06" name="UC-06 ROPA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1790" pageHeight="2094" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uc06-v3" value="ระบบบริหารบันทึกกิจกรรมการประมวลผลข้อมูลส่วนบุคคล&lt;br&gt;(Record of Processing Activities (RoPA))" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#1F4E78;strokeWidth=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="138" width="530" height="1916" as="geometry"/></mxCell><mxCell id="uc06-e4" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc06_a_OWNER" target="uc06_ROPA-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc06-e5" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc06_a_DPO" target="uc06_ROPA-03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc06-e6" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc06_a_OWNER" target="uc06_ROPA-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc06-e7" value="" style="endArrow=none;html=1;strokeColor=#8C8C8C;rounded=0;" edge="1" parent="1" source="uc06_a_OWNER" target="uc06_ROPA-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc06-e8" value="" style="endArrow=no