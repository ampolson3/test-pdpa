้ใช้งานทุกคน&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Employee / Any user&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936.0" y="126" width="180" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_ORGADMIN" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ผู้ดูแลระบบขององค์กร&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Organization Admin&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="54" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_DPO" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;DPO / Privacy Team&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;DPO / Privacy Team&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="216" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_LEGAL" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ฝ่ายกฎหมาย&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Legal&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="378" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_OWNER" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;เจ้าของกระบวนการ / ผู้ประสานงานแผนก&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Process Owner / Champion&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_IT" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;เจ้าของระบบ / IT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;System Owner / IT&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="702" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_MKT" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;การตลาด / ธุรกิจ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Marketing / Business&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="864" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_FRONT" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;พนักงานหน้าร้าน / Call center&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Front Staff&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1026" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_SEC" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ทีม Security / Incident&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Security / Incident Response&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1188" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_PROC" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;จัดซื้อ / ผู้ดูแลคู่ค้า&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Procurement / Vendor Manager&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1350" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_AUDIT" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ผู้ตรวจสอบ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Auditor&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1512" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_EXEC" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ผู้บริหาร / ผู้มีอำนาจอนุมัติ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Executive / Approver&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1674" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_MANAGER" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;หัวหน้าแผนก&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Line Manager&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1836" y="262" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_GUEST" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ผู้ใช้ภายนอก (guest link)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;External Guest&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="136.0" y="406" width="160" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_VENDOR" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;คู่ค้า / ผู้ประมวลผล (guest)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Vendor / Processor&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="54" y="542" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_COUNTER" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;คู่สัญญา (guest)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Agreement Counterparty&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="216" y="542" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_APICLIENT" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ระบบภายนอก (API client)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;API Client&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="518.0" y="406" width="160" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_WEB" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;&lt;br&gt;&lt;b&gt;เว็บไซต์ / แอปขององค์กร (SDK)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Website / App with SDK&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="436" y="542" width="150" height="62" as="geometry"/></mxCell><mxCell id="uc00_b_EXT" value='&lt;font style="font-size:9px" color="#7F7F7F"&gt;«actor»&lt;/font&gt;