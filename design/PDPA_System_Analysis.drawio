arent="1" source="t_ropa_questionnaires__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e7" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_activity_purposes__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e8" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_activity_data__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e9" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_retention_rules__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e10" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_activity_recipients__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e11" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_activity_transfers__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e12" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERzeroToOne;" edge="1" parent="1" source="t_ropa_activity_transfers__recipient_id" target="t_ropa_activity_recipients__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e13" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_activity_controls__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-e14" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_ropa_activity_rejections__activity_id" target="t_ropa_processing_activities__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd08-v1" value="ERD-08  ER Diagram — RoPA — กิจกรรมการประมวลผล ทะเบียนข้อมูล asset การโอน retention" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="erd08-v2" value="PK = primary key · FK = foreign key (มี constraint) · LFK = logical FK ไปตาราง partition (ตรวจใน service) · UQ = unique ต่อ tenant · ชื่อคอลัมน์ตัวหนา = NOT NULL · {a|b} = ค่าที่อนุญาต (CHECK) · → ตาราง = ตารางปลายทาง (ข้าม schema แสดงชื่อ schema) · ⟨P⟩ = partition รายเดือน · ⟨G⟩ = มีข้อมูลกลางของแพลตฟอร์ม&lt;br&gt;ทุกตารางมี tenant_id + RLS และคอลัมน์ created_at, created_by, updated_at, updated_by, row_version (ไม่แสดงเพื่อลดความรก) — รายละเอียดครบอยู่ในไฟล์ pdpa_schema.sql" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="