record_versions) และเข้าสู่ under_review / pending_approval&lt;br&gt;• ended: ยังเก็บไว้ตาม retention และใช้เป็นหลักฐาน&lt;br&gt;• assessment: ความเห็น DPO (dpo_opinions) ต้องมีก่อน approved&lt;br&gt;• approved ที่มีความเสี่ยงคงเหลือสูง ต้องมี risk.acceptances ที่ยังไม่หมดอายุ" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1620" y="102" width="380" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="st06" name="ST-06 Vendor"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="701" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st06-e14" value="" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st06-v4" target="st06-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st06-e15" value="ส่งแบบประเมิน&lt;br&gt;(guest link)" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st06-v5" target="st06-v6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="st06-e16" value="decision = approved" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st06-v6" target="st06-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st06-e17" value="decision = conditional&lt;br&gt;/ remediation_items" style="html=1;endArrow=open;endFill=0;endSize=10;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;rounded=1;" edge="1" parent="1" source="st06-v6" target="st06-v8"><mxGeometry 