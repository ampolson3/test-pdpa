ze=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="1958" width="150" height="22" as="geometry"/></mxCell><mxCell id="idx-v224" value="RoPA &amp;amp; Assessment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="190" y="1958" width="330" height="22" as="geometry"/></mxCell><mxCell id="idx-v225" value="ropa.processing_activities.status · assess.assessments.status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="1958" width="560" height="22" as="geometry"/></mxCell><mxCell id="idx-v226" value="&lt;b&gt;ST-06&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D9D9D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="150" height="22" as="geometry"/></mxCell><mxCell id="idx-v227" value="Vendor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D9D9D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="190" y="1980" width="330" height="22" as="geometry"/></mxCell><mxCell id="idx-v228" value="vendor.vendors.status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D9D9D9;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="1980" width="560" height="22" as="geometry"/></mxCell><mxCell id="idx-v229" value="&lt;b&gt;ST-07&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="2002" width="150" height="22" as="geometry"/></mxCell><mxCell id="idx-v230" value="User &amp;amp; Webhook" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="190" y="2002" width="330" height="22" as="geometry"/></mxCell><mxCell id="idx-v231" value="iam.users.status · platform.webhook_deliveries.status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9D9D9;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="2002" width="560" height="22" as="geometry"/></mxCell><mxCell id="idx-v232" value="&lt;b&gt;วิธีใช้ชุดเอกสารนี้&lt;/b&gt;&lt;br&gt;• เปิดด้วย draw.io (app.diagrams.net หรือ desktop) — ทุกหน้าแก้ไขต่อได้ ไม่ใช่รูปภาพ&lt;br&gt;• ใช้คู่กับไฟล์ pdpa_schema.sql (DDL ที่ generate จาก model เดียวกับ ERD และทดสอบรันบน PostgreSQL 16 แล้ว)&lt;br&gt;• รหัส use case = Function ID ใน Development Plan (Excel) → เปิดดู acceptance criteria / task / effort จากรหัสเดียวกัน&lt;br&gt;• ลำดับอ่านแนะนำ: ARC-01 → UC-00 → UC ของโมดูล → BP → DFD → ERD → SEQ / ST&lt;br&gt;• v1.1: ปรับให้ตรงกับ Development Plan (ค่าความปลอดภัย โครง monorepo event catalog) และเพิ่ม platform.public_keys — ชุดความรู้สำหรับ Claude Code (pdpa-claude-kit) สร้างจาก model เดียวกัน" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="190" width="560" height="156" as="geometry"/></mxCell><mxCell id="idx-v233" value="&lt;b&gt;ข้อตกลงร่วม (conventions)&lt;/b&gt;&lt;br&gt;• 1 module = 1 PostgreSQL schema = 1 Go package ภายใต้ backend/internal/ (16 schema)&lt;br&gt;• ตารางธุรกิจทุกตัวมี tenant_id + Row-Level Security · แอป SET LOCAL app.tenant_id ทุก transaction&lt;br&gt;• คอลัมน์มาตรฐาน: id (UUIDv7 ที่แอปสร้าง ยกเว้น audit_log ใช้ bigint identity), created_at / created_by / updated_at / updated_by, row_version (optimistic lock) — ไม่แสดงใน ERD&lt;br&gt;• เวลาเก็บเป็น timestamptz (UTC) · แสดงผล Asia/Bangkok · ปี พ.ศ. ตาม locale&lt;br&gt;• ค่าสถานะใช้ตัวพิมพ์เล็ก snake_case ตาม CHECK ใน DDL (ยกเว้น consent ใช้ตัวใหญ่ตาม FSD V3.2) และตรงกับหน้า ST&lt;br&gt;• API: /public/v1 · /portal/v1 · /admin/v1 · /api/v1 · /scim/v2 · /webhooks/* — สิทธิ์ผูกด้วย x-permission ใน OpenAPI&lt;br&gt;• event: &amp;lt;module&amp;gt;.&amp;lt;past-tense&amp;gt; เช่น consent.withdrawn · ส่งออกผ่าน outbox + webhook ที่ลงลายมือชื่อ HMAC&lt;br&gt;• ข้อมูลส่วนบุคคลที่อ่อนไหวเก็บแบบเข้ารหัส (*_enc) + blind index สำหรับค้นหา" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="362" width="560" height="214" as="geometry"/></mxCell><mxCell id="idx-v234" value="&lt;b&gt;สัญลักษณ์หลัก&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1140" y="592" width="560" height="22" as="geometry"/></mxCell><mxCell id="idx-v235" value="Must" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="620" width="110" height="36" as="geometry"/></mxCell><mxCell id="idx-v236" value="Should" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="620" width="110" height="36" as="geometry"/></mxCell><mxCell id="idx-v237" value="Nice" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="620" width="110" height="36" as="geometry"/></mxCell><mxCell id="idx-v238" value="use case ตามความสำคัญ" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1510" y="628" width="190" height="20" as="geometry"/></mxCell><mxCell id="id