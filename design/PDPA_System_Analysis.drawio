 relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp06_t8" target="bp06_t9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp06_t9" target="bp06_t10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp06_t10" target="bp06_t11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp06_t11" target="bp06_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-e23" value="เริ่มนับ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#7F7F7F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp06_t1" target="bp06_m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;startArrow=oval;startFill=0;fontSize=10;strokeColor=#7F7F7F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp06_m1" target="bp06_t12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp06-v1" value="BP-06  Business Process — จัดการคำขอใช้สิทธิของเจ้าของข้อมูล (DSAR)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp06-v2" value="Trigger: เจ้าของข้อมูลหรือผู้แทนยื่นคำขอ (เข้าถึง โอนย้าย คัดค้าน ลบ ระงับ แก้ไข ถอนความยินยอม) · ผลลัพธ์: ตอบภายใน SLA พร้อมหลักฐาน · UC: DSAR-01 ถึง DSAR-21" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp06_s" value="ยื่นคำขอ (portal / อีเมล / call center)" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp06_t1" value='สร้างคำขอ + เลขอ้างอิง + เริ่มนับ SLA&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST /public/v1/dsar-requests&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="259.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp06_t2" value='ยืนยันตัวตน OTP / ThaID / เอกสาร + ตรวจอำนาจผู้แทน&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;verifications&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_g1" value="ยืนยันได้?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="665.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp06_t3" value="ส่งข้อมูล / เอกสารเพิ่ม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_t4" value='คัดกรองประเภทสิทธิ + ตรวจข้อยกเว้น (ม.30–36)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;exemption_checks · legal_holds&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_g2" value="ปฏิเสธได้ตามกฎหมาย?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1001.0" y="528.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp06_t5" value="บันทึกเหตุผลการปฏิเสธลง RoPA + แจ้งผู้ขอ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="634.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_e2" value="ปิดคำขอ (ปฏิเสธ)" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1173.0" y="650.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp06_t6" value='สร้าง subtask ตามระบบที่เกี่ยวข้อง (RoPA / data map)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;subtasks&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_t7" value='ค้นหา ส่งออก แก้ไข ลบ ระงับ ตามสิทธิ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;search_results&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="768.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_t8" value='รวบรวมผล + ปกปิดข้อมูลบุคคลอื่น&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;packages · redactions&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_t9" value="ตรวจทานและอนุมัติคำตอบ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_t10" value='ส่งผลผ่าน secure link + แจ้งผู้ประมวลผล/ผู้รับข้อมูล&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;communications · downstream_notices&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="259.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp06_t11" value="ดาวน์โหลด / รับทราบผล" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1957.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06_e" value="ปิดคำขอ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2181.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp06_m1" value="SLA: เตือนวันที่ 20 / 25 / เกินกำหนด" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="333.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp06_t12" value="แจ้งเตือน / escalate ถึง DPO และหัวหน้า" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="634.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp06-v25" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• สิทธิเข้าถึงและขอรับสำเนา: ดำเนินการโดยไม่ชักช้า ไม่เกิน 30 วันนับแต่ได้รับคำขอ (ม.30); สิทธิอื่นใช้ SLA 30 วันเป็นค่าเริ่มต้นตามนโยบาย (ตั้งได้ต่อ request_type)&lt;br&gt;• ปฏิเสธได้เฉพาะเหตุตามกฎหมาย และต้องบันทึกการปฏิเสธพร้อมเหตุผลใน RoPA (ม.39)&lt;br&gt;• ต้องยืนยันตัวตนก่อนเปิดเผยข้อมูล; ผู้แทนต้องแสดงหลักฐานอำนาจ; ปกปิดข้อมูลของบุคคลอื่นในผลลัพธ์&lt;br&gt;• legal hold ระงับการลบ/ทำลาย; แจ้งผู้ประมวลผลให้ดำเนินการตามคำขอตามข้อตกลง (ม.40)&lt;br&gt;• ทุกการสื่อสารกับผู้ขอเก็บใน communications (หลักฐาน) และลิงก์ดาวน์โหลดหมดอายุ (ค่าเริ่มต้น 7 วัน)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="1039" height="105" as="geometry"/></mxCell><mxCell id="bp06-v26" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• dsar.requests · request_types · agents · verifications&lt;br&gt;• dsar.subtasks · search_results · exemption_checks · legal_holds&lt;br&gt;• dsar.packages · redactions · communications · downstream_notices&lt;br&gt;• iam.subject_verifications · platform.sla_timers" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1099" y="894" width="610" height="92" as="geometry"/></mxCell><mxCell id="bp06-v27" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /public/v1/dsar-requests · GET …/{ref}/status&lt;br&gt;• POST /api/v1/dsar/requests (ช่องทางหน้าร้าน / CRM)&lt;br&gt;• event: dsar.created · dsar.verified · dsar.sla_warning · dsar.completed · dsar.rejected&lt;br&gt;• webhook: dsar.subtask_assigned → ระบบ ITSM" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1729" y="894" width="571" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp07" name="BP-07 จัดการและแจ้งเหตุละเมิดข้อมูลส่วนบุคคล"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2508" pageHeight="1173" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp07-v3" value="ผู้พบเหตุ (พนักงาน / คู่ค้า / ภายนอก)" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2428" height="134" as="geometry"/></mxCell><mxCell id="bp07-v4" value="ทีม Security / Incident" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="2428" height="134" as="geometry"/></mxCell><mxCell id="bp07-v5" value="DPO" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7