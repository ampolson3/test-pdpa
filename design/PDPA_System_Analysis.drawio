ent_id" target="t_platform_documents__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd02-e5" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERzeroToOne;" edge="1" parent="1" source="t_platform_notifications__template_id" target="t_platform_notification_templates__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd02-e6" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_webhook_deliveries__subscription_id" target="t_platform_webhook_subscriptions__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd02-e7" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_platform_webhook_deliveries__event_id" target="t_platform_outbox_events__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd02-v1" value="ERD-02  ER Diagram — Platform — เอกสาร แจ้งเตือน event/webhook audit job connector AI" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="erd02-v2" value="PK = primary key · FK = foreign key (มี constraint) · LFK = logical FK ไปตาราง partition (ตรวจใน service) · UQ = unique ต่อ tenant · ชื่อคอลัมน์ตัวหนา = NOT NULL · {a|b} = ค่าที่อนุญาต (CHECK) · → ตาราง = ตารางปลายทาง (ข้าม schema แสดงชื่อ schema) · ⟨P⟩ = partition รายเดือน · ⟨G⟩ = มีข้อมูลกลางของแพลตฟอร์ม&lt;br&gt;ทุกตารางมี tenant_id + RLS และคอลัมน์ created_at, created_by, updated_at, updated_by, row_version (ไม่แสดงเพื่อลดความรก) — รายละเอียดครบอยู่ในไฟล์ pdpa_schema.sql" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="76" as="geometry"/></mxCell><mxCell id="t_platform_templates" value="platform.&lt;b&gt;templates&lt;/b&gt; ⟨G⟩" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fontSize=11;rounded=0;fillColor=#EEEEEE;strokeColor=#666666;swimlaneFillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="310" height="240" as="geometry"/></mxCell><mxCell id="t_platform_templates__desc" value="&lt;i&gt;template เอกสาร / ข้อความ (กลางและของ tenant) · ข้อมูลกลาง + ของ tenant (tenant_id ว่างได้)&lt;/i&gt;" style="text;strokeColor=#E0E0E0;fillColor=#FAFAFA;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=10;fontColor=#595959;points=[];" vertex="1" parent="t_platform_templates"><mxGeometry x="0" y="26" width="310" height="34" as="geometry"/></mxCell><mxCell id="t_platform_templates__id" value='&lt;b&gt;PK&lt;/b&gt;&amp;nbsp; &lt;b&gt;id&lt;/b&gt; &lt;font color="#7F7F7F"&gt;uuid&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=10;fillColor=#F5F9FF;" vertex="1" parent="t_platform_templates"><mxGeometry x="0" y="60" width="310" height="20" as="geometry"/></mxCell><mxCell id="t_platform_templates__template_type" value='&lt;b&gt;template_type&lt;/b&gt; &lt;font color="#7F7F7F"&gt;varchar(40)&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=10;" vertex="1" parent="t_