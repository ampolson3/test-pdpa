lative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc14-e32" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc14_VEN-01" target="uc14_VEN-02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc14-e33" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc14_VEN-05" target="uc14_VEN-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc14-e34" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc14_VEN-09" target="uc14_VEN-08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc14-e35" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#1F4E78;fontColor=#1F4E78;labelBackgroundColor=#F5F9FF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc14_VEN-15" target="uc14_VEN-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc14-v1" value="UC-14  Use Case — VEN: ระบบแบบประเมินคู่ค้า/คู่สัญญา (Vendor Assessment Module)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="uc14-v2" value="ขอบเขต: ทะเบียนและประเมินคู่ค้า/ผู้ประมวลผลตลอดวงจร ตั้งแต่คัดเลือกจนยุติการใช้บริการ&lt;br&gt;15 use cases · Must 7 · Should 7 · Nice 1 · รหัส use case = Function ID ใน Development Plan (ดู acceptance criteria และ task ได้จากรหัสเดียวกัน) · Pn = phase ที่พัฒนา" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1500" height="58" as="geometry"/></mxCell><mxCell id="uc14_VEN-01" value='&lt;b&gt;VEN-01&lt;/b&gt; ทะเบียนคู่ค้าและผู้ประมวลผล&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Vendor registry · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-02" value='&lt;b&gt;VEN-02&lt;/b&gt; จัดระดับความเสี่ยงคู่ค้า&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Vendor tiering · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="286" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-11" value='&lt;b&gt;VEN-11&lt;/b&gt; ผูกคู่ค้ากับสัญญาและกิจกรรม&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Link to DPA / DSA / RoPA · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-09" value='&lt;b&gt;VEN-09&lt;/b&gt; แผนแก้ไขข้อบกพร่องของคู่ค้า&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Vendor remediation plan · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-08" value='&lt;b&gt;VEN-08&lt;/b&gt; อนุมัติหรือปฏิเสธคู่ค้า&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Approval workflow · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="562" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-14" value='&lt;b&gt;VEN-14&lt;/b&gt; ยุติการใช้บริการ&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Vendor offboarding · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="654" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-13" value='&lt;b&gt;VEN-13&lt;/b&gt; แดชบอร์ดความเสี่ยงคู่ค้า&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Vendor risk dashboard · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="746" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-03" value='&lt;b&gt;VEN-03&lt;/b&gt; ผู้ประมวลผลช่วง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Sub-processor management · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="510" y="838" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-04" value='&lt;b&gt;VEN-04&lt;/b&gt; คลังแบบประเมินคู่ค้า&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Questionnaire templates · P2&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="330" height="66" as="geometry"/></mxCell><mxCell id="uc14_VEN-06" value='&lt;b&gt;VEN-06&lt;/b&gt; ตรวจหลักฐานและใบรับรอง&lt;br&gt;&lt;font style="font-size:9px" color="#595959"&gt;Evidence &amp;amp; certificates · P3&lt;/font&gt;' style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;" verte