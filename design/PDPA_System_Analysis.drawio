mxGeometry></mxCell><mxCell id="bp09-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp09_t6" target="bp09_t7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp09-e16" value="ส่งตรวจใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp09_t7" target="bp09_t5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360.0" y="486.0"/><mxPoint x="1061.5" y="486.0"/></Array></mxGeometry></mxCell><mxCell id="bp09-e17" value="ผ่าน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp09_g1" target="bp09_t8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1192.0" y="701.0"/></Array></mxGeometry></mxCell><mxCell id="bp09-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp09_t8" target="bp09_t9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp09-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp09_t9" target="bp09_t10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp09-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp09_t10" target="bp09_m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp09-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp09_m1" target="bp09_x1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp09-v1" value="BP-09  Business Process — รับคู่ค้าใหม่และติดตามความเสี่ยงคู่ค้า (Vendor onboarding &amp;amp; monitoring)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp09-v2" value="Trigger: ต้องการใช้บริการคู่ค้าที่เข้าถึงข้อมูลส่วนบุคคล / ครบรอบประเมิน · ผลลัพธ์: คู่ค้าผ่านการประเมิน มี DPA และถูกเชื่อมกับ RoPA · UC: VEN-01 ถึง VEN-15" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp09_s" value="ต้องการคู่ค้าใหม่ / ต่อสัญญา" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp09_t1" value='กรอก intake: บริการ ข้อมูลที่เข้าถึง ประเทศ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;vendor.intakes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t2" value="คัดกรอง tier ความเสี่ยง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t3" value='ส่งแบบประเมินผ่าน guest link&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;iam.guest_tokens&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t4" value='ตอบแบบประเมิน + แนบหลักฐาน (ISO 27001 ฯลฯ)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;vendor_assessments · certificates&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="393.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp09_t5" value="ตรวจ ให้คะแนน ระบุช่องว่าง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="532.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_g1" value="ผ่านเกณฑ์?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1169.0" y="544.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp09_t6" value='สร้าง remediation + กำหนดวัน&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;remediation_items&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t7" value="แก้ไข / ส่งหลักฐานเพิ่ม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="398.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t8" value="จัดทำ DPA / DSA (→ BP-10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="666.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t9" value="อนุมัติการใช้คู่ค้า" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="532.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_t10" value="เปิดใช้งาน + เชื่อม RoPA (ผู้รับข้อมูล) + ตั้งรอบประเมินซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1621.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp09_m1" value="ครบรอบ / ใบรับรองใกล้หมดอายุ" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1845.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp09_x1" value="ประเมินซ้ำ: กลับไปขั้น “ส่งแบบประเมิน”" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=3;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="1"><mxGeometry x="2013.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp09-v22" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• ผู้ควบคุมข้อมูลต้องจัดให้มีข้อตกลงควบคุมการดำเนินงานของผู้ประมวลผลให้เป็นไปตามกฎหมาย (ม.40)&lt;br&gt;• ส่งหรือโอนข้อมูลไปต่างประเทศต้องเป็นไปตาม ม.28 / ม.29 และประกาศ สคส. พ.ศ. 2566 → บันทึกใน activity_transfers&lt;br&gt;• รอบประเมินซ้ำตาม tier (ค่าเริ่มต้น: สูง 12 เดือน · กลาง 24 เดือน · ต่ำ 36 เดือน) และเมื่อใบรับรองหมดอายุ&lt;br&gt;• คู่ค้าเข้าระบบด้วย guest link ที่หมดอายุและเห็นเฉพาะแบบประเมินของตน&lt;br&gt;• สิ้นสุดสัญญา: offboarding ขอคืน / ทำลายข้อมูลพร้อมหลักฐาน" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="962" height="105" as="geometry"/></mxCell><mxCell id="bp09-v23" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• vendor.vendors · intakes · vendor_assessments&lt;br&gt;• vendor.remediation_items · certificates · sub_processors · offboardings&lt;br&gt;• iam.guest_tokens · assess.assessments&lt;br&gt;• agreement.agreements (DPA)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1022" y="792" width="564" height="92" as="geometry"/></mxCell><mxCell id="bp09-v24" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /admin/v1/vendors/intakes&lt;br&gt;• GET /public/v1/guest/{token}/assessment · POST …/answers&lt;br&gt;• event: vendor.assessment_completed · vendor.approved · vendor.certificate_expiring" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1606" y="792" width="526" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp10" name="BP-10 จัดทำและบริหารข้อตกลง DPA / DSA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2508" pageHeight="937" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp10-v3" value="ฝ่ายกฎหมาย" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontS