e4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_m2" target="bp02_t13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_t13" target="bp02_g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-e25" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp02_g3" target="bp02_t8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2032.0" y="685.0"/></Array></mxGeometry></mxCell><mxCell id="bp02-e26" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp02_g3" target="bp02_e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp02-v1" value="BP-02  Business Process — ถอนความยินยอม หมดอายุ และกระทบยอด (Withdrawal, expiry &amp;amp; reconcile)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp02-v2" value="Trigger: เจ้าของข้อมูลขอถอน / consent ครบอายุ / งานกระทบยอดรายวัน · ผลลัพธ์: สถานะตรงกันทุกระบบ ระบบปลายทางหยุดประมวลผล · UC: CON-13, CON-18, CON-19, CON-20, CON-21" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp02_s1" value="ต้องการถอนความยินยอม" style="ellipse;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02_t1" value="เข้า Preference Center / แจ้ง call center" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t2" value='ยืนยันตัวตน OTP / login&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;iam.subject_verifications&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t3" value="แสดงผลกระทบของการถอน (ถ้ามี)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t4" value="ยืนยันการถอน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t5" value='บันทึก WITHDRAWN + อัปเดต consent_status&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;POST /public/v1/consents&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t6" value="Outbox → webhook consent.withdrawn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1117.0" y="264.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t7" value="หยุดประมวลผล / นำออกจาก audience + ACK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_g1" value="ACK ครบภายใน SLA?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1505.0" y="276.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp02_e1" value="ถอนสำเร็จ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1677.0" y="280.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02_t8" value="ติดตามระบบที่ค้าง แก้ไขข้อมูลไม่ตรง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_m1" value="ทุกวัน 01:00" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02_t9" value='หา consent ครบ expires_at → EXPIRED + event&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;consent.expired&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="382.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_g2" value="ตั้ง re-consent?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="497.0" y="394.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp02_e2" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="669.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02_t11" value='อนุมัติแคมเปญขอความยินยอมใหม่&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;campaigns&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_t12" value='ส่งคำขอ re-consent ตามช่องทาง (→ BP-01)&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;campaign_recipients&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="382.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp02_e4" value="จบ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1005.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02_m2" value="Reconcile รายวัน" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1677.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02_t13" value='ดึงสถานะปลายทาง เทียบ consent_status&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;reconcile_runs · reconcile_items&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1789.0" y="377.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp02_g3" value="ไม่ตรงกัน?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="2009.0" y="394.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp02_e3" value="ตรงกัน" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="2181.0" y="398.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp02-v27" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• ถอนความยินยอมได้ตลอดเวลา และต้องถอนได้ง่ายเช่นเดียวกับการให้ความยินยอม (ม.19)&lt;br&gt;• การถอนไม่กระทบการประมวลผลที่ทำไปแล้วโดยชอบ และต้องแจ้งผลกระทบของการถอนให้เจ้าของข้อมูลทราบ (ม.19)&lt;br&gt;• ถอนผ่านช่องทางใดก็ได้ (preference center, call center, API) และมีผลทุกช่องทาง&lt;br&gt;• ระบบปลายทางต้อง ACK ภายใน SLA (ค่าเริ่มต้น 24 ชม.) ไม่เช่นนั้นเข้าคิว reconcile และแจ้ง DPO&lt;br&gt;• consent ที่หมดอายุถือว่าไม่ได้รับความยินยอม (EXPIRED) จนกว่าจะให้ใหม่" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="1039" height="105" as="geometry"/></mxCell><mxCell id="bp02-v28" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• consent.consent_transactions ⟨P⟩ · consent_status&lt;br&gt;• iam.subject_verifications&lt;br&gt;• consent.downstream_syncs&lt;br&gt;• consent.reconcile_runs · reconcile_items&lt;br&gt;• consent.campaigns · campaign_recipients" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1099" y="776" width="610" height="105" as="geometry"/></mxCell><mxCell id="bp02-v29" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• POST /public/v1/otp/send · /verify&lt;br&gt;• GET /public/v1/preferences (session ของ portal)&lt;br&gt;• event: consent.withdrawn · consent.expired&lt;br&gt;• event: consent.mismatch_found&lt;br&gt;• job: consent.expiry_sweep · consent.reconcile (River)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1729" y="776" width="571" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp03" name="BP-03 แบนเนอร์คุกกี้และการสแกนเว็บไซต์"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="937" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp03-v3" value="ผู้เข้าชมเว็บไซต์" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1420" height="134" as="geometry"/></mxCell><