FFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1440" y="1018" width="700" height="30" as="geometry"/></mxCell><mxCell id="arc04-v83" value="&lt;b&gt;กติกาการเชื่อมต่อ&lt;/b&gt;&lt;br&gt;• consumer ต้อง idempotent ตาม X-Event-Id (ส่งซ้ำได้) · ลำดับรับประกันเฉพาะภายใน aggregate เดียวกัน (เช่น subject + purpose)&lt;br&gt;• webhook payload ไม่ใส่ข้อมูลส่วนบุคคลเกินจำเป็น: ใช้ subject_ref (UUID) ให้ปลายทางเรียก API กลับเมื่อจำเป็น&lt;br&gt;• connector credential เก็บใน OpenBao · connector ของ discovery ใช้สิทธิ์ read-only และเก็บเฉพาะ metadata + ตัวอย่างที่ mask แล้ว&lt;br&gt;• breaking change → เพิ่ม /v2 และคง /v1 อย่างน้อย 12 เดือน · deprecation header" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1068" width="2060" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arc05" name="ARC-05 App structure"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="736" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arc05-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc05-v8" target="arc05-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc05-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc05-v9" target="arc05-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc05-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSi