id="arc02-v16" value='&lt;b&gt;scanner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;1–4 · node pool แยก + egress proxy&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="630.0" y="240" width="245.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v17" value='&lt;b&gt;gotenberg&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;×2 · internal only&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="885.0" y="240" width="245.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v18" value='&lt;b&gt;clamav&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;×2 · clamd + freshclam&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="630.0" y="308" width="245.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v19" value='&lt;b&gt;migrate (Job)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;goose · Argo CD PreSync hook&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="885.0" y="308" width="245.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v21" value='&lt;b&gt;keycloak&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;×2 HA (Infinispan) · DB แยก&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170.0" y="172" width="175.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v22" value='&lt;b&gt;keycloak-db&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;PostgreSQL (CloudNativePG)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1355.0" y="172" width="175.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v24" value='&lt;b&gt;openbao&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;×3 (raft) · auto-unseal KMS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170.0" y="342" width="175.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v25" value='&lt;b&gt;external-secrets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;sync secret → pod&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1355.0" y="342" width="175.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v27" value='&lt;b&gt;otel-collector&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;DaemonSet&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330.0" y="512" width="192.5" height="58" as="geometry"/></mxCell><mxCell id="arc02-v28" value="&lt;b&gt;prometheus + alertmanager&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="532.5" y="512" width="192.5" height="58" as="geometry"/></mxCell><mxCell id="arc02-v29" value="&lt;b&gt;grafana&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735.0" y="512" width="192.5" height="58" as="geometry"/></mxCell><mxCell id="arc02-v30" value='&lt;b&gt;loki / tempo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;log · trace&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="937.5" y="512" width="192.5" height="58" as="geometry"/></mxCell><mxCell id="arc02-v32" value='&lt;b&gt;argo-cd&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;GitOps · app-of-apps&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1170.0" y="512" width="175.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v33" value='&lt;b&gt;argo-rollouts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;canary api / web&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1355.0" y="512" width="175.0" height="58" as="geometry"/></mxCell><mxCell id="arc02-v35" value='&lt;b&gt;PostgreSQL 16+ (CloudNativePG / managed)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;primary + 2 replicas (sync 1) · PITR: WAL → object storage · backup เก็บ 35 วัน&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1620" y="142" width="420" height="120" as="geometry"/></mxCell><mxCell id="arc02-v36" value='&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Sentinel ×3 · AOF&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1620" y="287" width="200" height="90" as="geometry"/></mxCell><mxCell id="arc02-v37" value='&lt;b&gt;Object storage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;S3 / MinIO ×4 (erasure coding) · versioning · object lock (หลักฐาน)&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1840" y="287" width="200" height="110" as="geometry"/></mxCell><mxCell id="arc02-v38" value='&lt;b&gt;Cloud KMS / HSM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;root key สำหรับ auto-unseal และ KEK&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="402" width="200" height="70" as="geometry"/></mxCell><mxCell id="arc02-v46" value='&lt;b&gt;Kubernetes (scale ต่ำ)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Argo CD sync manifest เดียวกัน · scale up เมื่อ failover&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="812" width="300" height="80" as="geometry"/></mxCell><mxCell id="arc02-v47" value='&lt;b&gt;PostgreSQL replica (async)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;streaming / WAL archive restore&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="660" y="807" width="280" height="90" as="geometry"/></mxCell><mxCell id="arc02-v48" value='&lt;b&gt;Object storage replica&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;bucket replication&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="980" y="807" width="240" height="90" as="geometry"/></mxCell><mxCell id="arc02-v51" value="&lt;b&gt;เป้าหมายความพร้อมใช้งาน (ปรับตาม SLA ที่ตกลง)&lt;/b&gt;&lt;br&gt;• Availability 99.9% ต่อเดือน (prod) · RPO ≤ 15 นาที · RTO ≤ 4 ชั่วโมง&lt;br&gt;• ทดสอบ restore ทุกไตรมาส และซ้อม failover ปีละ 1 ครั้ง&lt;br&gt;• Consent API / banner config มี CDN cache — แบนเนอร์ยังทำงานได้ระหว่าง API ขัดข้อง" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1600" y="942" width="460" height="78" as="geometry"/></mxCell><mxCell id="arc02-v52" value="&lt;b&gt;Environment&lt;/b&gt;&lt;br&gt;• dev — deploy อัตโนมัติจาก main · ข้อมูลสังเคราะห์ · scale ต่ำ&lt;br&gt;• sit — ทดสอบ integration กับ IdP / e-Sign / SMS sandbox · ข้อมูลสังเคราะห์&lt;br&gt;• uat — ผู้ใช้ทดสอบรับงาน · ข้อมูลที่ผ่าน masking (gov.masking_jobs) เท่านั้น ห้ามใช้ข้อมูลจริง&lt;br&gt;• prod — deploy ด้วย manual approval + change window · canary 10% → 50% → 100% (Argo Rollouts)&lt;br&gt;• dr — warm standby, sync manifest และข้อมูลต่อเนื่อง" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="952" width="1520" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arc03" name="ARC-03 Security"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="994" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arc03-v3" value="Internet (untrusted)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#FAFAFA;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="240" height="330" as="geometry"/></mxCell><mxCell id="arc03-v7" value="Edge / DMZ" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#FFF8F0;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="310" y="102" width="260" height="330" as="geometry"/></mxCell><mxCell id="arc03-v10" value="App zone" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#F4FAF2;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="600" y="102" width="520" height="330" as="geometry"/></mxCell><mxCell id="arc03-v14" value="Data zone" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#FFFCF0;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1150" y="102" width="330" height="330" as="geometry"/></mxCell><mxCell id="arc03-v18" value="Management zone" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#F7F2FA;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1510" y="102" width="330" height="330" as="geometry"/></mxCell><mxCell id="arc03-e22" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="267" as="sourcePoint"/><mxPoint x="310" y="267" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arc03-e23" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="267" as="sourcePoint"/><mxPoint x="600" y="267" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arc03-e24" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="267" as="sourcePoint"/><mxPoint x="1150" y="267" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arc03-e25" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="267" as="sourcePoint"/><mxPoint x="1510" y="267" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arc03-e55" value="wrap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc03-v50" target="arc03-v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc03-e56" value="wrap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc03-v51" target="arc03-v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc03-e57" value="encrypt / decrypt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc03-v52" target="arc03-v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc03-v1" value="ARC-03  Security Architecture — zone, การควบคุม และลำดับชั้นกุญแจเข้ารหัส" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2100" height="34" as="geometry"/></mxCell><mxCell id="arc03-v2" value="ออกแบบตามประกาศคณะกรรมการฯ เรื่องมาตรการรักษาความมั่นคงปลอดภัย พ.ศ. 2565 (ม.37(1)) และ OWASP ASVS ระดับ 2 · ทุกเส้นเชื่อมใช้ TLS 1.2 ขึ้นไป" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="2100" height="22" as="geometry"/></mxCell><mxCell id="arc03-v4" value="&lt;b&gt;ผู้ใช้ / เจ้าของข้อมูล&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="142" width="210" height="70" as="geometry"/></mxCell><mxCell id="arc03-v5" value='&lt;b&gt;API client&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;OAuth2 client credentials&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="232" width="210" height="70" as="geometry"/></mxCell><mxCell id="arc03-v6" value="&lt;b&gt;ผู้โจมตี&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="322" width="210" height="70" as="geometry"/></mxCell><mxCell id="arc03-v8" value='&lt;b&gt;CDN + WAF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;OWASP CRS · bot · DDoS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="325" y="142" width="230" height="70" as="geometry"/></mxCell><mxCell id="arc03-v9" value='&lt;b&gt;Ingress&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;TLS · HSTS · rate limit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="325" y="232" width="230" height="70" as="geometry"/></mxCell><mxCell id="arc03-v11" value='&lt;b&gt;Next.js BFF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;session httpOnly · SameSite=Lax · CSRF token · CSP&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="142" width="490" height="70" as="geometry"/></mxCell><mxCell id="arc03-v12" value='&lt;b&gt;Go API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;authn → tenant → authz → idempotency → tx&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="232" width="490" height="70" as="geometry"/></mxCell><mxCell id="arc03-v13" value='&lt;b&gt;worker / scanner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;egress allowlist · SSRF guard&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="322" width="490" height="70" as="geometry"/></mxCell><mxCell id="arc03-v15" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;RLS · TLS · encrypted at rest&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1165" y="142" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc03-v16" value='&lt;b&gt;Valkey&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ACL · TLS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1165" y="232" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc03-v17" value='&lt;b&gt;Object storage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;SSE · signed URL · object lock&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1165" y="322" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc03-v19" value='&lt;b&gt;OpenBao / KMS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;keys · secrets&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1525" y="142" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc03-v20" value='&lt;b&gt;Argo CD / CI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;GitOps · signed images&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1525" y="232" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc03-v21" value='&lt;b&gt;Observability / SIEM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;audit · security events&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1525" y="322" width="300" height="70" as="geometry"/></mxCell><mxCell id="arc03-v26" value="เข้าถึง management zone ผ่าน SSO + MFA + bastion เท่านั้น (just-in-time access)" style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#7030A0;" vertex="1" parent="1"><mxGeometry x="1510" y="438" width="330" height="30" as="geometry"/></mxCell><mxCell id="arc03-v27" value="&lt;b&gt;การควบคุมตามชั้น (control matrix)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="800" height="22" as="geometry"/></mxCell><mxCell id="arc03-v28" value="&lt;b&gt;ชั้น&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#1F4E78;fontSize=10;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="180" height="28" as="geometry"/></mxCell><mxCell id="arc03-v29" value="&lt;b&gt;การควบคุม&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#1F4E78;fontSize=10;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="220" y="492" width="1260" height="28" as="geometry"/></mxCell><mxCell id="arc03-v30" value="&lt;b&gt;ตาราง / หลักฐานที่เกี่ยวข้อง&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#1F4E78;fontSize=10;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1480" y="492" width="520" height="28" as="geometry"/></mxCell><mxCell id="arc03-v31" value="&lt;b&gt;Identity&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="180" height="50" as="geometry"/></mxCell><mxCell id="arc03-v32" value="Keycloak OIDC + PKCE · MFA (TOTP / WebAuthn) บังคับสำหรับ Super Admin, Org Admin, DPO, Privacy, Security, Auditor + step-up ก่อน unmask / export จำนวนมาก / เปลี่ยน role · lockout ผิด 5 ครั้งล็อก 30 นาที · session idle 30 นาที / สูงสุด 12 ชม. · SSO SAML/OIDC ขององค์กร · SCIM · guest token (hash, หมดอายุ 7–30 วัน, ผูกงานเดียว) · OTP เจ้าของข้อมูล (hash, 5 นาที, 5 ครั้ง)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="220" y="520" width="1260" height="50" as="geometry"/></mxCell><mxCell id="arc03-v33" value="iam.users · idp_configs · guest_tokens · subject_verifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="520" width="520" height="50" as="geometry"/></mxCell><mxCell id="arc03-v34" value="&lt;b&gt;Authorization&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="180" height="50" as="geometry"/></mxCell><mxCell id="arc03-v35" value="RBAC + data scope (tenant / legal entity / org unit) · x-permission ต่อ endpoint ใน OpenAPI · PostgreSQL RLS ต่อ tenant · field masking + unmask log · maker-checker · break-glass มีวันหมดอายุ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="220" y="570" width="1260" height="50" as="geometry"/></mxCell><mxCell id="arc03-v36" value="iam.roles · permissions · role_assignments · field_masking_rules · unmask_logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="570" width="520" height="50" as="geometry"/></mxCell><mxCell id="arc03-v37" value="&lt;b&gt;Data protection&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="arc03-v38" value="TLS 1.2+ ทุกเส้น · AES-256-GCM envelope encryption สำหรับฟิลด์ PII (*_enc) · blind index HMAC-SHA256 สำหรับค้นหา · hash IP / UA · backup เข้ารหัส · signed URL หมดอายุ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="220" y="620" width="1260" height="50" as="geometry"/></mxCell><mxCell id="arc03-v39" value="consent.subject_identifiers · platform.files" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="620" width="520" height="50" as="geometry"/></mxCell><mxCell id="arc03-v40" value="&lt;b&gt;Application&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="180" height="50" as="geometry"/></mxCell><mxCell id="arc03-v41" value="OWASP ASVS L2 · validate ตาม OpenAPI · CSP / HSTS / X-Frame-Options · CSRF (BFF) · rate limit (Valkey token bucket) · Idempotency-Key · สแกนไฟล์ ClamAV + ตรวจ MIME · SSRF guard (บล็อก private IP) สำหรับ scanner / webhook" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="220" y="670" width="1260" height="50" as="geometry"/></mxCell><mxCell id="arc03-v42" value="platform.files · webhook_subscriptions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="670" width="520" height="50" as="geometry"/></mxCell><mxCell id="arc03-v43" value="&lt;b&gt;Audit &amp;amp; monitoring&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="180" height="50" as="geometry"/></mxCell><mxCell id="arc03-v44" value="audit_log append-only (partition รายเดือน, ห้าม UPDATE/DELETE) · security_events · ส่งออก SIEM (OTLP / syslog) · alert: login ผิดปกติ, unmask จำนวนมาก, export จำนวนมาก" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="220" y="720" width="1260" height="50" as="geometry"/></mxCell><mxCell id="arc03-v45" value="platform.audit_log ⟨P⟩ · iam.security_events ⟨P⟩" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="720" width="520" height="50" as="geometry"/></mxCell><mxCell id="arc03-v46" value="&lt;b&gt;Supply chain &amp;amp; ops&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="180" height="50" as="geometry"/></mxCell><mxCell id="arc03-v47" value="SBOM + cosign sign image · govulncheck / osv-scanner / semgrep ใน CI · secret อยู่ใน OpenBao เท่านั้น (ไม่อยู่ใน git) · least-privilege service account · NetworkPolicy default-deny" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="220" y="770" width="1260" height="50" as="geometry"/></mxCell><mxCell id="arc03-v48" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#BFBFBF;fontSize=9;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1480" y="770" width="520" height="50" as="geometry"/></mxCell><mxCell id="arc03-v49" value="&lt;b&gt;ลำดับชั้นกุญแจ (envelope encryption)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="800" height="22" as="geometry"/></mxCell><mxCell id="arc03-v50" value='&lt;b&gt;Root key (KMS / HSM)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ไม่ออกจาก HSM&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="220" height="60" as="geometry"/></mxCell><mxCell id="arc03-v51" value='&lt;b&gt;KEK ต่อ tenant (OpenBao transit)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;หมุนทุก 12 เดือน&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="894" width="260" height="60" as="geometry"/></mxCell><mxCell id="arc03-v52" value='&lt;b&gt;DEK ต่อ tenant + ประเภทข้อมูล&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;เก็บแบบห่อ (wrapped) ใน DB · cache ใน memory จำกัดเวลา&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="894" width="320" height="60" as="geometry"/></mxCell><mxCell id="arc03-v53" value='&lt;b&gt;ฟิลด์ *_enc (AES-256-GCM)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;value_enc · birth_date_enc · contact_enc&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="894" width="280" height="60" as="geometry"/></mxCell><mxCell id="arc03-v54" value='&lt;b&gt;Blind index key (HMAC) แยกต่อ tenant&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;subject_identifiers.blind_index → ค้นหาแบบตรงตัวโดยไม่ถอดรหัส&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="894" width="360" height="60" as="geometry"/></mxCell><mxCell id="arc03-v58" value="&lt;b&gt;การหมุนกุญแจ&lt;/b&gt;&lt;br&gt;• KEK หมุนได้โดยไม่ต้องเข้ารหัสข้อมูลใหม่ (rewrap DEK)&lt;br&gt;• DEK ใหม่ใช้กับข้อมูลใหม่; job re-encrypt ทีละ batch&lt;br&gt;• ลบ tenant = ทำลาย KEK (crypto-shredding)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1800" y="860" width="300" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arc04" name="ARC-04 Integration"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arc04-v3" value="API surfaces (inbound)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#F3F8FE;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="520" height="520" as="geometry"/></mxCell><mxCell id="arc04-v21" value="Outbound" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;dashed=1;fillColor=#F7F7F7;strokeColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="1640" y="102" width="460" height="520" as="geometry"/></mxCell><mxCell id="arc04-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v4" target="arc04-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v5" target="arc04-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v6" target="arc04-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v7" target="arc04-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v8" target="arc04-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v9" target="arc04-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e18" value="1 tx: data + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v10" target="arc04-v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e20" value="poll / LISTEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v17" target="arc04-v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v19" target="arc04-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v19" target="arc04-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v19" target="arc04-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v19" target="arc04-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v19" target="arc04-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arc04-v19" target="arc04-v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc04-v1" value="ARC-04  Integration Architecture — API surfaces, webhook / outbox, connector และ event catalog" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2100" height="34" as="geometry"/></mxCell><mxCell id="arc04-v2" value="ทุก API นิยามใน OpenAPI 3.1 (ไฟล์เดียวแยก tag) · response error ตาม RFC 9457 (problem+json) · versioning ใน path (/v1) · pagination แบบ cursor" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="2100" height="22" as="geometry"/></mxCell><mxCell id="arc04-v4" value='&lt;b&gt;/public/v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;SDK / portal แบบไม่ login · public key ของ domain / collection point · CORS allowlist · rate limit ต่อ IP&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="142" width="480" height="64" as="geometry"/></mxCell><mxCell id="arc04-v5" value='&lt;b&gt;/portal/v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;เจ้าของข้อมูลหลังยืนยัน OTP · session สั้น (30 นาที)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="480" height="64" as="geometry"/></mxCell><mxCell id="arc04-v6" value='&lt;b&gt;/admin/v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Admin app ผ่าน BFF · JWT ผู้ใช้ · x-permission + data scope&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="298" width="480" height="64" as="geometry"/></mxCell><mxCell id="arc04-v7" value='&lt;b&gt;/api/v1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ระบบภายนอก · OAuth2 client credentials (token ≤ 15 นาที · scope) · IP allowlist · quota ต่อ client · หมุน secret 90 วัน&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="376" width="480" height="64" as="geometry"/></mxCell><mxCell id="arc04-v8" value='&lt;b&gt;/scim/v2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;Directory provisioning · bearer token ต่อ tenant&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="454" width="480" height="64" as="geometry"/></mxCell><mxCell id="arc04-v9" value='&lt;b&gt;/webhooks/*&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;callback ขาเข้า (e-Sign, สถานะ email/SMS) · ตรวจ HMAC + timestamp ≤ 5 นาที&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="532" width="480" height="64" as="geometry"/></mxCell><mxCell id="arc04-v10" value='&lt;b&gt;Go API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;router → middleware → module handler&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="302" width="220" height="100" as="geometry"/></mxCell><mxCell id="arc04-v17" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ข้อมูลธุรกิจ + outbox_events (ใน transaction เดียวกัน)&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="940" y="292" width="240" height="120" as="geometry"/></mxCell><mxCell id="arc04-v19" value='&lt;b&gt;worker (River jobs)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;outbox dispatcher: SELECT … FOR UPDATE SKIP LOCKED → webhook_deliveries (ลำดับต่อ aggregate) · connector · notification · AI · SIEM export&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="282" width="300" height="140" as="geometry"/></mxCell><mxCell id="arc04-v22" value='&lt;b&gt;Webhook subscriber&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;POST JSON · X-Signature: HMAC-SHA256(ts.body) · X-Event-Id · retry 1m, 5m, 30m, 2h, 6h, 24h → dead + แจ้งเตือน&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#EEEEEE;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="142" width="420" height="64" as="geometry"/></mxCell><mxCell id="arc04-v23" value='&lt;b&gt;Connectors&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;DB / file / cloud storage (discovery, read-only) · CRM / ITSM (DSAR subtask)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#EEEEEE;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="220" width="420" height="64" as="geometry"/></mxCell><mxCell id="arc04-v24" value='&lt;b&gt;Email · SMS · LINE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;template ต่อ tenant · สถานะการส่งกลับทาง /webhooks&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#EEEEEE;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="298" width="420" height="64" as="geometry"/></mxCell><mxCell id="arc04-v25" value='&lt;b&gt;e-Signature&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;ส่งเอกสาร + รับ callback เมื่อลงนาม&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#EEEEEE;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="376" width="420" height="64" as="geometry"/></mxCell><mxCell id="arc04-v26" value='&lt;b&gt;AI gateway → LLM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;mask PII ก่อนส่ง · log prompt / token · quota ต่อ tenant&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#EEEEEE;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="454" width="420" height="64" as="geometry"/></mxCell><mxCell id="arc04-v27" value='&lt;b&gt;SIEM export&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px" color="#404040"&gt;audit_log + security_events (OTLP / syslog)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#EEEEEE;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="532" width="420" height="64" as="geometry"/></mxCell><mxCell id="arc04-v34" value="&lt;b&gt;Event catalog&lt;/b&gt; — ชื่อ event รูปแบบ &amp;lt;module&amp;gt;.&amp;lt;past-tense&amp;gt; · envelope: {id (UUIDv7), type, tenant_id, occurred_at, subject, data, version}" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="662" width="1600" height="22" as="geometry"/></mxCell><mxCell id="arc04-v35" value="&lt;b&gt;event&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#1F4E78;fontSize=10;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="620" height="26" as="geometry"/></mxCell><mxCell id="arc04-v36" value="&lt;b&gt;producer&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#1F4E78;fontSize=10;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="660" y="692" width="140" height="26" as="geometry"/></mxCell><mxCell id="arc04-v37" value="&lt;b&gt;ฟิลด์หลักใน data&lt;/b&gt;" style="rounded=0