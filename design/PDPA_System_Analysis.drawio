r)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1170" y="1943.0" width="36" height="64" as="geometry"/></mxCell><mxCell id="uc09-v43" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1430" y="138" width="260" height="22" as="geometry"/></mxCell><mxCell id="uc09-v44" value="Must — กฎหมายกำหนด / จำเป็น" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="166" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc09-v45" value="Should — มาตรฐานตลาด" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="212" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc09-v46" value="Nice-to-have — จุดขายเพิ่ม" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="258" width="230" height="38" as="geometry"/></mxCell><mxCell id="uc09-v47" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1438" y="310" width="22" height="40" as="geometry"/></mxCell><mxCell id="uc09-v48" value="ผู้ใช้ภายในองค์กร" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1418" y="354" width="80" height="30" as="geometry"/></mxCell><mxCell id="uc09-v49" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00