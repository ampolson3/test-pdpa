isks__risk_id" target="t_risk_risks__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd10-e15" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_assess_dpo_opinions__assessment_id" target="t_assess_assessments__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd10-e16" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#6C8EBF;endArrow=ERmandOne;" edge="1" parent="1" source="t_assess_consultations__assessment_id" target="t_assess_assessments__id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="erd10-v1" value="ERD-10  ER Diagram — Risk &amp;amp; Assessment — ความเสี่ยง control gap และ assessment engine (DPIA/LIA/TIA)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1760" height="34" as="geometry"/></mxCell><mxCell id="erd10-v2" value="PK = primary key · FK = foreign key (มี constraint) · LFK = logical FK ไปตาราง partition (ตรวจใน service) · UQ = unique ต่อ tenant · ชื่อคอลัมน์ตัวหนา = NOT NULL · {a|b} = ค่าที่อนุญาต (CHECK) · → ตาราง = ตารางปลายทาง (ข้าม schema แสดงชื่อ schema) · ⟨P⟩ = partition รายเดือน · ⟨G⟩ = มีข้อมูลกลางของแพลตฟอร์ม&lt;br&gt;ทุกตารางมี tenant_id + RLS และคอลัมน์ created_at, created_by, updated_at, updated_by, row_version (ไม่แสดงเพื่อลดความรก) — รายละเอียดครบอยู่ในไฟล์ pdpa_schema.sql" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1760" height="76" as="geometry"/></mxCell><mxCell id="t_risk_risk_matrices" value="risk.&lt;b&gt;risk_matrices&lt;/b&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26