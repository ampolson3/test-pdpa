_t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp11_t3" target="bp11_t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp11_t4" target="bp11_t5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp11_t5" target="bp11_g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-e15" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bp11_g2" target="bp11_t4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1192.0" y="417.0"/></Array></mxGeometry></mxCell><mxCell id="bp11-e16" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp11_g2" target="bp11_t6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-e17" value="ผลการลบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp11_t6" target="bp11_t7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#404040;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bp11_t7" target="bp11_e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bp11-v1" value="BP-11  Business Process — ระยะเวลาเก็บรักษาและการทำลายข้อมูล (Retention &amp;amp; disposal)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="34" as="geometry"/></mxCell><mxCell id="bp11-v2" value="Trigger: งานตรวจรายวันพบข้อมูลครบกำหนด · ผลลัพธ์: ข้อมูลถูกลบ / ทำลาย / ทำให้ไม่ระบุตัวตน พร้อมหลักฐาน หรือระงับด้วย legal hold · UC: DPX-05, DPX-06, ROPA-10" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#595959;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/></mxCell><mxCell id="bp11_m1" value="ทุกวัน 02:00" style="ellipse;shape=doubleEllipse;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="165.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp11_t1" value='หาข้อมูลที่ครบระยะเวลาเก็บ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;retention_schedules · retention_rules&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277.0" y="125.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="bp11_g1" value="มี legal hold?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="497.0" y="142.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp11_t2" value='ระงับ + บันทึกเหตุผล&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;dsar.legal_holds&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="248.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp11_e1" value="ระงับไว้" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="669.0" y="264.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp11_t3" value='สร้าง disposal job + รายการ&lt;br&gt;&lt;font style="font-size:9px" color="#44546A"&gt;disposal_jobs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp11_t4" value="ยืนยันรายการที่จะทำลาย" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="781.0" y="382.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp11_t5" value="อนุมัติ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="949.0" y="516.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp11_g2" value="อนุมัติ?" style="rhombus;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontSize=10;whiteSpace=wrap;spacingBottom=2;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="1169.0" y="528.0" width="46" height="46" as="geometry"/></mxCell><mxCell id="bp11_t6" value="ลบ / ทำลาย / ทำให้ไม่ระบุตัวตนในระบบต้นทาง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285.0" y="650.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp11_t7" value="ตรวจผล + ออกหลักฐานการทำลาย" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1453.0" y="130.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="bp11_e2" value="เสร็จ" style="ellipse;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=4;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=10;whiteSpace=wrap;labelWidth=130;" vertex="1" parent="1"><mxGeometry x="1677.0" y="146.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="bp11-v19" value="&lt;b&gt;กฎทางธุรกิจ / ข้อกำหนดกฎหมาย&lt;/b&gt;&lt;br&gt;• ต้องลบ ทำลาย หรือทำให้ไม่สามารถระบุตัวบุคคลได้ เมื่อพ้นระยะเวลาเก็บ หรือไม่เกี่ยวข้อง / เกินความจำเป็น หรือเมื่อถอนความยินยอม (ม.37(3))&lt;br&gt;• legal hold (คดี ข้อพิพาท คำสั่งหน่วยงาน) ระงับการลบจนกว่าจะปลด และต้องระบุเหตุผล&lt;br&gt;• หลักฐานการทำลายเก็บเป็น audit record ที่ไม่มีข้อมูลส่วนบุคคล&lt;br&gt;• ข้อมูลใน backup หมดอายุตามรอบ backup ที่ระบุในนโยบาย (ไม่กู้คืนข้อมูลที่ทำลายแล้ว)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="807" height="92" as="geometry"/></mxCell><mxCell id="bp11-v20" value="&lt;b&gt;ตารางข้อมูลที่เกี่ยวข้อง (ERD)&lt;/b&gt;&lt;br&gt;• gov.retention_schedules · disposal_jobs&lt;br&gt;• ropa.retention_rules&lt;br&gt;• dsar.legal_holds&lt;br&gt;• platform.audit_log ⟨P⟩" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F2F7FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="867" y="776" width="474" height="92" as="geometry"/></mxCell><mxCell id="bp11-v21" value="&lt;b&gt;Event / API ที่เกี่ยวข้อง&lt;/b&gt;&lt;br&gt;• job: retention.sweep (River cron 02:00)&lt;br&gt;• event: retention.due · disposal.approved · disposal.completed&lt;br&gt;• connector: คำสั่งลบไปยังระบบต้นทาง (webhook / ITSM ticket)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E5;strokeColor=#BF9000;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#F4F0F7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1361" y="776" width="435" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bp12" name="BP-12 บริหารผู้ใช้และสิทธิ์"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2508" pageHeight="1291" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bp12-v3" value="HRIS / Directory (SCIM)" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="2428" height="252" as="geometry"/></mxCell><mxCell id="bp12-v4" value="PDPA Platform · IAM" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="2428" height="252" as="geometry"/></mxCell><mxCell id="bp12-v5" value="Keycloak / IdP" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="602" width="2428" height="252" as="geometry"/></mxCell><mxCell id="bp12-v6" value="ผู้ใช้ / หัวหน้างาน" style="swimlane;horizontal=0;html=1;startSize=44;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;" vertex="